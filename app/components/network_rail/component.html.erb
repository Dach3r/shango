<nav aria-label="<%= @label %>" class="flex shrink-0 overflow-x-auto border-b border-line lg:w-16 lg:flex-col lg:overflow-visible lg:border-r lg:border-b-0">
  <% @items.group_by { |item| item[:group] }.each_with_index do |(group, items), index| %>
    <div role="group" aria-label="<%= group %>" class="<%= class_names(GROUP, SEPARATOR => index.positive?) %>">
      <% items.each do |item| %>
        <%= link_to item[:path], class: LINK, title: item[:label], aria: { label: item[:label], current: (item[:name].to_s == @current ? "page" : nil) } do %>
          <%= lucide_icon item[:icon], class: "size-4" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</nav>
