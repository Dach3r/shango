<div class="flex w-full flex-col">
  <div class="flex items-center gap-3 px-4 py-3 lg:group-data-[collapsed=true]/sidebar:justify-center lg:group-data-[collapsed=true]/sidebar:px-0" title="<%= @user.full_name %>">
    <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-solid text-xs font-semibold text-on-solid" aria-hidden="true"><%= @user.initials %></span>
    <div class="min-w-0 lg:group-data-[collapsed=true]/sidebar:hidden">
      <p class="truncate text-sm font-medium text-ink"><%= @user.full_name %></p>
      <p class="truncate text-xs text-muted"><%= @user.email %></p>
    </div>
  </div>
  <div class="lg:group-data-[collapsed=true]/sidebar:hidden flex items-center justify-between gap-2 border-t border-line px-4 py-3">
    <%= render ThemeSwitcher::Component.new %>
    <%= render LocaleSwitcher::Component.new %>
  </div>
  <%= button_to destroy_user_session_path, method: :delete, form_class: "contents",
                title: t("components.user_menu.sign_out"),
                class: "flex h-10 w-full cursor-pointer items-center gap-3 border-t border-line px-4 lg:group-data-[collapsed=true]/sidebar:justify-center lg:group-data-[collapsed=true]/sidebar:px-0 text-left text-sm text-body transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-accent/50" do %>
    <%= lucide_icon "log-out", class: "size-4 shrink-0" %>
    <span class="lg:group-data-[collapsed=true]/sidebar:hidden"><%= t("components.user_menu.sign_out") %></span>
  <% end %>
</div>
