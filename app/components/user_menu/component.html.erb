<div class="relative shrink-0" data-controller="dropdown" data-action="click@window->dropdown#closeOnOutside keydown.esc->dropdown#closeOnEscape">
  <button type="button" data-dropdown-target="trigger" data-action="dropdown#toggle" aria-haspopup="true" aria-expanded="false"
          aria-label="<%= t("components.user_menu.label") %>" title="<%= @user.full_name %>"
          class="flex h-full cursor-pointer items-center px-3 transition hover:bg-field focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50">
    <span class="flex size-7 items-center justify-center border border-line bg-field text-xs font-semibold text-ink" aria-hidden="true"><%= @user.initials %></span>
  </button>

  <div data-dropdown-target="menu" hidden class="absolute right-0 top-full z-30 w-64 border border-t-0 border-line bg-card p-0">
    <div class="flex h-14 items-center gap-3 px-3">
      <span class="flex size-9 shrink-0 items-center justify-center bg-solid text-xs font-semibold text-on-solid" aria-hidden="true"><%= @user.initials %></span>
      <div class="min-w-0">
        <p class="truncate text-sm font-medium text-ink"><%= @user.full_name %></p>
        <p class="truncate text-xs text-muted"><%= @user.email %></p>
      </div>
    </div>
    <div class="border-t border-line"></div>
    <%= link_to edit_user_registration_path,
                class: "flex h-14 w-full items-center gap-3 px-3 text-left text-sm text-body transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
      <%= lucide_icon "settings", class: "size-4 shrink-0" %>
      <%= t("components.user_menu.settings") %>
    <% end %>
    <%= button_to destroy_user_session_path, method: :delete, form_class: "contents",
                  class: "flex h-14 w-full cursor-pointer items-center gap-3 px-3 text-left text-sm text-body transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
      <%= lucide_icon "log-out", class: "size-4 shrink-0" %>
      <%= t("components.user_menu.sign_out") %>
    <% end %>
  </div>
</div>
