<div class="flex w-full flex-col gap-1">
  <div class="flex items-center gap-3 px-2.5 py-2">
    <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-solid text-xs font-semibold text-on-solid" aria-hidden="true"><%= @user.initials %></span>
    <div class="min-w-0">
      <p class="truncate text-sm font-medium text-ink"><%= @user.full_name %></p>
      <p class="truncate text-xs text-muted"><%= @user.email %></p>
    </div>
  </div>
  <div class="flex items-center justify-between gap-2 px-2.5 py-2">
    <%= render ThemeSwitcher::Component.new %>
    <%= render LocaleSwitcher::Component.new %>
  </div>
  <%= button_to destroy_user_session_path, method: :delete, form_class: "contents",
                class: "flex w-full cursor-pointer items-center gap-3 rounded-xl px-2.5 py-2 text-left text-sm text-body transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50" do %>
    <%= lucide_icon "log-out", class: "size-4 shrink-0" %>
    <%= t("components.user_menu.sign_out") %>
  <% end %>
</div>
