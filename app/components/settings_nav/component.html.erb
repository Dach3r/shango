<nav aria-label="<%= t("components.settings_nav.label") %>" class="space-y-6">
  <% groups.each do |group| %>
    <div>
      <h2 class="mb-2 truncate px-3 text-[0.6875rem] font-semibold tracking-wider text-muted uppercase"><%= group[:label] %></h2>
      <ul class="space-y-1">
        <% group[:items].each do |item| %>
          <li><%= render NavItem::Component.new(**item) %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
</nav>
