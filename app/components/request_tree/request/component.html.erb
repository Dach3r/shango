<%= tag.li class: "group relative data-[drop-active=before]:shadow-[inset_0_2px_0_var(--solid)]", **row_attributes do %>
  <%= link_to workbench_request_path(@api_request), class: classes, aria: { current: (@active ? "page" : nil) } do %>
    <span class="w-9 shrink-0"><%= render MethodBadge::Component.new(method: @api_request.http_method, short: true, request_id: @api_request.id) %></span>
    <%= tag.span @api_request.name, class: "min-w-0 flex-1 truncate", **name_attributes %>
  <% end %>
  <% if @manage %>
    <div class="absolute right-1 top-1">
      <%= render RequestTree::Menu::Component.new(label: t("components.request_tree.actions", name: @api_request.name)) do %>
        <button type="button" data-action="context-menu#rename" class="<%= RequestTree::Menu::Component::ITEM %>"><%= lucide_icon "pencil", class: "size-4" %><%= t("components.request_tree.rename") %></button>
        <%= button_to workbench_request_duplication_path(@api_request), method: :post, form_class: "contents", class: RequestTree::Menu::Component::ITEM do %><%= lucide_icon "copy", class: "size-4" %><%= t("components.request_tree.duplicate") %><% end %>
        <%= button_to workbench_request_path(@api_request), method: :delete, form_class: "contents", form: { data: { turbo_confirm: t("workbench.requests.confirm_delete", name: @api_request.name) } },
                      class: "#{RequestTree::Menu::Component::ITEM} !text-danger" do %><%= lucide_icon "trash-2", class: "size-4" %><%= t("components.request_tree.delete") %><% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
