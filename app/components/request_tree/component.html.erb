<nav aria-label="<%= t("components.request_tree.label") %>" data-controller="tree sidebar-view" data-tree-toggle-value="<%= @folder_toggle %>" data-tree-open-value="<%= @request_open %>" data-tree-collapse-nested-value="<%= @collapse_nested %>" data-action="dragover->tree#dragOver drop->tree#drop" class="flex h-full flex-col">
  <div data-sidebar-view-target="collections" class="flex h-10 shrink-0 items-center justify-between gap-2 border-b border-line px-4">
    <h2 class="flex items-center gap-2 text-sm font-semibold text-ink">
      <%= lucide_icon "library", class: "size-4 text-muted" %>
      <%= t("components.request_tree.title") %>
    </h2>
    <div class="flex items-center gap-1">
      <button type="button" data-action="sidebar-view#showHistory" aria-label="<%= t("components.request_tree.history") %>" title="<%= t("components.request_tree.history") %>"
              class="flex size-6 items-center justify-center text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50">
        <%= lucide_icon "history", class: "size-3.5" %>
      </button>
      <%= link_to new_workbench_import_path, data: { turbo_frame: "modal" }, aria: { label: t("components.request_tree.import") }, title: t("components.request_tree.import"),
                  class: "flex size-6 items-center justify-center text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
        <%= lucide_icon "upload", class: "size-3.5" %>
      <% end %>
      <%= link_to new_workbench_collection_path, data: { turbo_frame: "modal" }, aria: { label: t("components.request_tree.new_collection") }, title: t("components.request_tree.new_collection"),
                  class: "flex size-6 items-center justify-center text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
        <%= lucide_icon "plus", class: "size-3.5" %>
      <% end %>
    </div>
  </div>

  <div data-sidebar-view-target="history" hidden class="flex h-10 shrink-0 items-center justify-between gap-2 border-b border-line px-4">
    <h2 class="flex items-center gap-2 text-sm font-semibold text-ink">
      <%= lucide_icon "history", class: "size-4 text-muted" %>
      <%= t("components.request_tree.history_title") %>
    </h2>
    <button type="button" data-action="sidebar-view#showCollections" aria-label="<%= t("components.request_tree.back") %>" title="<%= t("components.request_tree.back") %>"
            class="flex size-6 items-center justify-center text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50">
      <%= lucide_icon "arrow-left", class: "size-3.5" %>
    </button>
  </div>

  <div data-sidebar-view-target="collections" class="min-h-0 flex-1 space-y-1 overflow-y-auto px-2 pb-4">
    <% if @branches.empty? %>
      <p class="px-2 py-6 text-center text-sm text-muted"><%= t("components.request_tree.empty") %></p>
    <% end %>
    <% @branches.each do |branch| %>
      <%= render RequestTree::Collection::Component.new(branch:, current_request_id: @current_request_id, closed_ids: @closed_ids, manage: manage?(branch)) %>
    <% end %>
  </div>
  <div data-sidebar-view-target="history" hidden class="min-h-0 flex-1 space-y-1 overflow-y-auto px-2 pb-4">
    <% if @history_groups.empty? %>
      <p class="px-2 py-6 text-center text-sm text-muted"><%= t("components.request_tree.history_empty") %></p>
    <% end %>
    <% @history_groups.each do |group| %>
      <details open class="group/branch">
        <summary class="flex cursor-pointer list-none items-center gap-2 py-1.5 pr-2 pl-2 text-sm font-medium text-ink transition hover:bg-field focus:outline-none focus-visible:outline-none [&::-webkit-details-marker]:hidden">
          <%= lucide_icon "chevron-right", class: "size-4 shrink-0 text-muted transition [details[open]>summary>&]:rotate-90" %>
          <%= lucide_icon "folder-open", class: "size-4 shrink-0 text-accent" %>
          <span class="min-w-0 flex-1 truncate"><%= group.collection.name %></span>
        </summary>
        <ul class="ml-3 space-y-0.5 border-l border-line pl-1.5">
          <% group.executions.each do |execution| %>
            <li>
              <%= link_to helpers.workbench_request_path(execution.api_request), title: execution.url, aria: { current: (execution.api_request_id == @current_request_id ? "page" : nil) },
                          class: class_names("flex items-center gap-2 py-1.5 pr-2 pl-2 text-sm transition hover:bg-field focus:outline-none focus-visible:outline-none", "bg-field font-medium text-ink": execution.api_request_id == @current_request_id, "text-body": execution.api_request_id != @current_request_id) do %>
                <span class="w-9 shrink-0"><%= render MethodBadge::Component.new(method: execution.http_method, short: true) %></span>
                <span class="min-w-0 flex-1 truncate"><%= execution.api_request.name %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  </div>
</nav>
