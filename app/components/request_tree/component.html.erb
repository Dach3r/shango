<nav aria-label="<%= t("components.request_tree.label") %>" data-controller="tree" data-tree-toggle-value="<%= @folder_toggle %>" data-tree-open-value="<%= @request_open %>" data-tree-collapse-nested-value="<%= @collapse_nested %>" data-action="dragover->tree#dragOver drop->tree#drop" class="flex h-full flex-col">
  <div class="flex h-10 shrink-0 items-center justify-between gap-2 border-b border-line px-4">
    <h2 class="flex items-center gap-2 text-sm font-semibold text-ink">
      <%= lucide_icon "library", class: "size-4 text-muted" %>
      <%= t("components.request_tree.title") %>
    </h2>
    <div class="flex items-center gap-1">
      <%= link_to workbench_history_path, aria: { label: t("components.request_tree.history") }, title: t("components.request_tree.history"),
                  class: class_names("flex size-6 items-center justify-center transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50", "bg-field text-ink": helpers.controller_path == "workbench/histories", "text-muted": helpers.controller_path != "workbench/histories") do %>
        <%= lucide_icon "history", class: "size-3.5" %>
      <% end %>
      <%= link_to new_workbench_import_path, data: { turbo_frame: "modal" }, aria: { label: t("components.request_tree.import") }, title: t("components.request_tree.import"),
                  class: "flex size-6 items-center justify-center text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
        <%= lucide_icon "upload", class: "size-3.5" %>
      <% end %>
      <%= link_to new_workbench_collection_path, data: { turbo_frame: "modal" }, aria: { label: t("components.request_tree.new_collection") }, title: t("components.request_tree.new_collection"),
                  class: "flex size-6 items-center justify-center text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
        <%= lucide_icon "plus", class: "size-3.5" %>
      <% end %>
    </div>
  </div>

  <div class="min-h-0 flex-1 space-y-1 overflow-y-auto px-2 pb-4">
    <% if @branches.empty? %>
      <p class="px-2 py-6 text-center text-sm text-muted"><%= t("components.request_tree.empty") %></p>
    <% end %>
    <% @branches.each do |branch| %>
      <%= render RequestTree::Collection::Component.new(branch:, current_request_id: @current_request_id) %>
    <% end %>
  </div>
</nav>
