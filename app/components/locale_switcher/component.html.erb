<div role="group" aria-label="<%= t("components.locale_switcher.label") %>" class="flex border border-line bg-card/80 backdrop-blur">
  <% I18n.available_locales.each do |locale| %>
    <%= button_to LABELS.fetch(locale), preferences_path, method: :patch, params: { locale: locale }, form_class: "flex border-line not-first:border-l",
                  class: button_classes(locale), lang: locale, aria: { label: NAMES.fetch(locale), current: ("true" if current?(locale)) } %>
  <% end %>
</div>
