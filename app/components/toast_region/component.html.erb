<div id="toasts" aria-live="polite" class="pointer-events-none fixed inset-x-0 top-5 z-50 flex flex-col items-center gap-2 px-5 sm:inset-x-auto sm:right-8 sm:top-8 sm:w-96 sm:items-end sm:px-0">
  <% toasts.each do |kind, message| %>
    <%= render Toast::Component.new(kind: kind, message: message) %>
  <% end %>
</div>
