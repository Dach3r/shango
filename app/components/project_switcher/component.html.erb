<div class="relative shrink-0" data-controller="dropdown" data-action="click@window->dropdown#closeOnOutside keydown.esc->dropdown#closeOnEscape">
  <button type="button" data-dropdown-target="trigger" data-action="dropdown#toggle" aria-haspopup="true" aria-expanded="false"
          title="<%= @current_project.name %>"
          class="flex h-full max-w-60 cursor-pointer items-center gap-2.5 px-3 md:w-72 md:max-w-none md:border-r md:border-line text-left transition hover:bg-field focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50">
    <span class="flex size-7 shrink-0 items-center justify-center bg-solid text-on-solid"><%= lucide_icon @current_project.icon, class: "size-3.5" %></span>
    <span class="hidden min-w-0 flex-1 truncate text-sm font-semibold text-ink sm:block"><%= @current_project.name %></span>
    <%= lucide_icon "chevrons-up-down", class: "hidden size-3.5 shrink-0 text-muted sm:block md:ml-auto" %>
  </button>

  <div data-dropdown-target="menu" hidden class="fixed inset-x-0 bottom-0 top-12 z-30">
    <div data-action="click->dropdown#close" class="absolute inset-0 bg-night-1000/60"></div>
    <div class="absolute left-0 top-0 w-60 border border-line bg-card md:w-72">
      <p class="px-3 pb-1 pt-3 font-mono text-[10px] uppercase tracking-wider text-faint"><%= t("components.project_switcher.label") %></p>
      <ul class="max-h-64 overflow-y-auto pb-1">
        <% @projects.each do |project| %>
          <% current = project == @current_project %>
          <li>
            <%= button_to current_project_path, method: :patch, params: { project_id: project.id }, form_class: "contents",
                          class: class_names("flex h-10 w-full cursor-pointer items-center gap-2.5 px-3 text-left text-sm transition hover:bg-field focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50", "bg-field font-semibold text-ink shadow-[inset_2px_0_0_var(--accent)]" => current, "text-body hover:text-ink" => !current) do %>
              <span class="flex size-6 shrink-0 items-center justify-center border border-line"><%= lucide_icon project.icon, class: "size-3.5" %></span>
              <span class="min-w-0 flex-1 truncate"><%= project.name %></span>
              <%= lucide_icon "check", class: "size-4 shrink-0 text-accent" if current %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= link_to new_project_path, class: "flex h-10 items-center gap-2.5 border-t border-line px-3 text-sm font-medium text-body transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
        <span class="flex size-6 shrink-0 items-center justify-center border border-dashed border-line"><%= lucide_icon "plus", class: "size-3.5" %></span>
        <%= t("components.project_switcher.new") %>
      <% end %>
    </div>
  </div>
</div>
