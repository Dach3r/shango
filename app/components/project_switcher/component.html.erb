<div class="relative shrink-0" data-controller="dropdown" data-action="click@window->dropdown#closeOnOutside keydown.esc->dropdown#closeOnEscape">
  <button type="button" data-dropdown-target="trigger" data-action="dropdown#toggle" aria-haspopup="true" aria-expanded="false"
          title="<%= @current_project.name %>"
          class="flex h-full max-w-60 cursor-pointer items-center gap-2.5 px-3 text-left transition hover:bg-field focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50">
    <span class="flex size-7 shrink-0 items-center justify-center bg-solid text-on-solid"><%= lucide_icon @current_project.icon, class: "size-3.5" %></span>
    <span class="hidden min-w-0 flex-1 truncate text-sm font-semibold text-ink sm:block"><%= @current_project.name %></span>
    <%= lucide_icon "chevrons-up-down", class: "hidden size-3.5 shrink-0 text-muted sm:block" %>
  </button>

  <div data-dropdown-target="menu" hidden class="absolute left-0 top-full z-30 w-60 border border-t-0 border-line bg-card p-0">
    <p class="px-3 py-2 text-xs font-medium text-muted"><%= t("components.project_switcher.label") %></p>
    <ul class="max-h-64 overflow-y-auto">
      <% @projects.each do |project| %>
        <li>
          <%= button_to current_project_path, method: :patch, params: { project_id: project.id }, form_class: "contents",
                        class: "flex w-full cursor-pointer items-center h-14 gap-3 px-3 text-left text-sm text-body transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
            <%= lucide_icon project.icon, class: "size-4 shrink-0" %>
            <span class="min-w-0 flex-1 truncate"><%= project.name %></span>
            <%= lucide_icon "check", class: "size-4 shrink-0 text-accent" if project == @current_project %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <div class="border-t border-line"></div>
    <%= link_to new_project_path, class: "flex items-center h-14 gap-3 px-3 text-sm font-medium text-accent transition hover:bg-field hover:text-accent-hover focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
      <%= lucide_icon "plus", class: "size-4 shrink-0" %>
      <%= t("components.project_switcher.new") %>
    <% end %>
  </div>
</div>
