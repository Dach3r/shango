<% if @href %>
  <%= link_to @href, class: classes, title: @label, aria: { current: ("page" if @active) } do %>
    <%= lucide_icon @icon, class: icon_classes %>
    <span class="truncate lg:group-data-[collapsed=true]/sidebar:hidden"><%= @label %></span>
  <% end %>
<% else %>
  <span class="<%= classes %>" title="<%= @label %>" aria-disabled="true">
    <%= lucide_icon @icon, class: icon_classes %>
    <span class="truncate lg:group-data-[collapsed=true]/sidebar:hidden"><%= @label %></span>
    <span class="lg:group-data-[collapsed=true]/sidebar:hidden ml-auto text-[10px] leading-none font-medium tracking-wider text-faint uppercase"><%= t("components.nav_item.soon") %></span>
  </span>
<% end %>
