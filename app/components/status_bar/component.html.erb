<footer class="sticky bottom-0 z-20 flex h-10 shrink-0 items-center gap-3 border-t border-line bg-page px-3 sm:px-4">
  <% if @sidebar_toggle %>
    <button type="button" data-sidebar-toggle-target="button" data-action="sidebar-toggle#toggle" aria-expanded="true" aria-label="<%= t("components.status_bar.toggle_sidebar") %>" title="<%= t("components.status_bar.toggle_sidebar") %>"
            class="-ml-3 flex h-full w-9 shrink-0 cursor-pointer items-center justify-center text-muted transition hover:bg-field-focus hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50 sm:-ml-4">
      <%= lucide_icon "panel-left", class: "size-4" %>
    </button>
  <% end %>
  <% if content? %>
    <div class="min-w-0 flex-1"><%= content %></div>
  <% end %>

  <div class="-mr-3 ml-auto flex h-full items-center sm:-mr-4">
    <% if @environments %>
      <%= render EnvironmentSwitcher::Component.new(environments: @environments, current_environment: @current_environment, compact: true) %>
    <% end %>
  </div>
</footer>
