<footer class="sticky bottom-0 z-20 flex h-10 shrink-0 items-center gap-3 border-t border-line bg-page px-3 sm:px-4">
  <% if content? %>
    <div class="min-w-0 flex-1"><%= content %></div>
  <% end %>

  <div class="-mr-3 ml-auto flex h-full items-center sm:-mr-4">
    <%# Looks like a search field; clicking it opens the command palette. The shortcut shown depends on the system (see shortcut_hint_controller.js). %>
    <button type="button" data-action="palette#open" data-controller="shortcut-hint" title="<%= t("components.status_bar.search") %>" aria-label="<%= t("components.status_bar.search") %>"
            class="mx-2 flex h-7 w-8 cursor-pointer items-center justify-center gap-2 border border-line bg-field text-xs text-faint transition hover:border-accent/60 hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50 sm:mx-3 sm:w-56 sm:justify-start sm:px-2.5">
      <%= lucide_icon "search", class: "size-3.5 shrink-0" %>
      <span class="hidden min-w-0 flex-1 truncate text-left sm:inline"><%= t("components.status_bar.search_placeholder") %></span>
      <kbd data-shortcut-hint-target="key" hidden class="hidden shrink-0 border border-line px-1.5 font-mono text-[0.625rem] text-muted sm:inline-block"></kbd>
    </button>
    <% if @open_incidents.positive? %>
      <%= link_to monitoring_incidents_path(state: "open"), title: t("components.status_bar.incidents", total: @open_incidents), aria: { label: t("components.status_bar.incidents", total: @open_incidents) },
            class: "flex h-full items-center gap-2 px-3 font-mono text-xs text-danger transition hover:bg-field focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-accent/50" do %>
        <span aria-hidden="true" class="size-1.5 rounded-full bg-current"></span><%= @open_incidents %>
      <% end %>
    <% end %>
    <% if @environments %>
      <%= render EnvironmentSwitcher::Component.new(environments: @environments, current_environment: @current_environment, compact: true) %>
    <% end %>
    <%= render ProjectSwitcher::Component.new(current_project: @project, projects: @projects) %>
    <%= render UserMenu::Component.new(user: @user) %>
  </div>
</footer>
