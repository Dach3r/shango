<%= tag.div data: { controller: ("password-visibility" if password?) } do %>
  <%= @form.label @attribute, @label, class: LABEL_CLASSES %>
  <div class="relative">
  <%= field %>
  <% if password? %>
    <button type="button" aria-label="Mostrar u ocultar contraseña" data-action="password-visibility#toggle"
            class="absolute inset-y-0 right-4 flex items-center text-neutral-400 hover:text-neutral-700">
      <%= lucide_icon "eye", class: "size-5", "data-password-visibility-target" => "show" %>
      <%= lucide_icon "eye-off", class: "hidden size-5", "data-password-visibility-target" => "hide" %>
    </button>
  <% end %>
  </div>
<% end %>
