<div class="flex h-full flex-col">
  <div class="flex flex-1 flex-col gap-3">
    <%= render ProjectSwitcher::Component.new(current_project: @current_project, projects: @projects) %>

    <nav aria-label="<%= t("components.sidebar.label") %>">
      <ul>
        <% live_items.each do |item| %>
          <li><%= render NavItem::Component.new(**item) %></li>
        <% end %>
      </ul>

      <div class="mx-auto my-3 hidden h-px w-6 bg-line lg:group-data-[collapsed=true]/sidebar:block" aria-hidden="true"></div>
      <ul>
        <% soon_items.each do |item| %>
          <li><%= render NavItem::Component.new(**item) %></li>
        <% end %>
      </ul>
    </nav>
  </div>

  <div class="sticky bottom-0 shrink-0 bg-card">
    <div>
      <%= render UserMenu::Component.new(user: @user) %>
    </div>
  </div>
</div>
