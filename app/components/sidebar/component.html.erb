<div class="flex h-full flex-col">
  <div class="flex flex-1 flex-col gap-5 px-3 py-4">
    <%= render ProjectSwitcher::Component.new(current_project: @current_project, projects: @projects) %>

    <nav aria-label="<%= t("components.sidebar.label") %>">
      <ul class="space-y-1">
        <% items.each do |item| %>
          <li><%= render NavItem::Component.new(**item) %></li>
        <% end %>
      </ul>
    </nav>
  </div>

  <div class="sticky bottom-0 shrink-0 bg-card">
    <div class="border-t border-line px-3 py-2">
      <%= render NavItem::Component.new(**settings) %>
    </div>
    <%= render UserMenu::Component.new(user: @user) %>
  </div>
</div>
