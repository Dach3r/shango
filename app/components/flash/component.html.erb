<div role="<%= config[:role] %>" data-controller="flash" data-flash-delay-value="<%= @kind == :alert ? 8000 : 5000 %>"
     data-action="mouseenter->flash#pause mouseleave->flash#resume focusin->flash#pause focusout->flash#resume"
     class="<%= classes %>">
  <div class="mx-auto flex w-full max-w-3xl items-center gap-3 py-3 pr-3 pl-4">
    <%= lucide_icon config[:icon], class: "size-5 shrink-0", "aria-hidden": true %>
    <p class="min-w-0 flex-1 leading-snug"><%= @message %></p>
    <button type="button" data-action="flash#close" aria-label="<%= t("components.flash.close") %>"
            class="flex size-7 shrink-0 cursor-pointer items-center justify-center opacity-70 transition hover:opacity-100 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-on-solid/50">
      <%= lucide_icon "x", class: "size-4" %>
    </button>
  </div>
</div>
