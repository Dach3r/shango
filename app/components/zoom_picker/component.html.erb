<%= form_with url: preferences_path, method: :patch, data: { controller: "zoom" } do %>
  <fieldset>
    <legend class="sr-only"><%= t("components.zoom_picker.label") %></legend>
    <div class="flex flex-wrap gap-2">
      <% levels.each do |level| %>
        <label class="cursor-pointer">
          <%= radio_button_tag :zoom, level, current?(level), class: "peer sr-only", data: { action: "zoom#apply" } %>
          <span class="flex min-w-[4.25rem] flex-col items-center rounded-lg border border-line bg-card px-3 py-1.5 text-sm font-medium text-body transition hover:border-accent/50 hover:text-ink peer-checked:border-transparent peer-checked:bg-solid peer-checked:text-on-solid peer-focus-visible:ring-2 peer-focus-visible:ring-accent/50">
            <%= level %>%
            <% if default?(level) %>
              <span class="text-[0.625rem] font-normal leading-tight opacity-70"><%= t("components.zoom_picker.default") %></span>
            <% end %>
          </span>
        </label>
      <% end %>
    </div>
  </fieldset>
<% end %>
