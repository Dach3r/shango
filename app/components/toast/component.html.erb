<div role="<%= config[:role] %>" data-controller="toast" data-toast-delay-value="<%= @kind == :alert ? 8000 : 5000 %>"
     data-action="mouseenter->toast#pause mouseleave->toast#resume focusin->toast#pause focusout->toast#resume"
     class="<%= classes %>">
  <%= lucide_icon config[:icon], class: "size-5 shrink-0", "aria-hidden": true %>
  <p class="min-w-0 flex-1 leading-snug"><%= @message %></p>
  <button type="button" data-action="toast#close" aria-label="<%= t("components.toast.close") %>"
          class="flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-full opacity-70 transition hover:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50">
    <%= lucide_icon "x", class: "size-4" %>
  </button>
</div>
