<label class="group flex cursor-pointer flex-col gap-2 text-center text-sm text-muted transition hover:text-ink has-[:checked]:text-ink">
  <%= form.radio_button :theme, theme, class: "sr-only peer", data: { action: "theme-preview#apply", scheme: Membership.pinned_scheme(theme) } %>
  <div data-palette="default" class="contents">
    <div data-palette="<%= theme %>" aria-hidden="true" class="relative h-24 overflow-hidden border border-line bg-page transition group-has-[:checked]:border-solid group-has-[:checked]:ring-1 group-has-[:checked]:ring-solid group-has-[:focus-visible]:ring-1 group-has-[:focus-visible]:ring-solid">
      <div class="absolute inset-y-0 left-0 w-1/4 border-r border-line bg-card"></div>
      <div class="absolute inset-x-0 top-0 left-1/4 h-4 border-b border-line"></div>
      <div class="absolute top-6 left-[32%] h-3 w-1/4 bg-solid"></div>
      <div class="absolute top-11 left-[32%] h-1.5 w-1/2 bg-line"></div>
      <div class="absolute top-14 left-[32%] h-1.5 w-2/5 bg-line"></div>
      <div class="absolute bottom-2 left-[32%] flex gap-1.5">
        <span class="size-2.5 bg-accent"></span>
        <span class="size-2.5 bg-muted"></span>
        <span class="size-2.5 bg-danger"></span>
      </div>
    </div>
  </div>
  <span><%= t("projects.themes.edit.themes.#{theme}") %></span>
</label>
