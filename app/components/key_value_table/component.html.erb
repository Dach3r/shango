<%= tag.div data: wrapper_data do %>
  <div class="overflow-hidden border border-line">
    <% if pairs? %>
      <div class="flex h-11 items-center divide-x divide-line border-b border-line bg-ink/[0.03] text-xs font-medium uppercase tracking-wide text-muted">
        <span class="min-w-0 flex-1 px-5"><%= @key_placeholder %></span>
        <span class="min-w-0 flex-[1.4] px-5"><%= @value_placeholder %></span>
        <span class="hidden min-w-0 flex-1 px-5 lg:block"><%= t("components.key_value_table.description") %></span>
        <span class="h-full w-[5.25rem] shrink-0"></span>
      </div>
    <% end %>

    <div data-key-value-table-target="body" class="[&>*]:border-b [&>*]:border-line">
      <% @rows.each_with_index do |row, index| %>
        <%= render row_component(row, index) %>
      <% end %>
    </div>

    <template data-key-value-table-target="template">
      <%= render row_component({ "enabled" => true }, "NEW_INDEX") %>
    </template>
  </div>

  <div class="<%= class_names("flex", "px-3 py-3": pairs?, "pt-3": !pairs?) %>">
    <button type="button" data-action="key-value-table#add"
            class="inline-flex cursor-pointer items-center gap-1.5 px-2 py-1 text-xs font-medium text-muted transition hover:bg-accent/10 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50">
      <%= lucide_icon "plus", class: "size-3.5" %>
      <%= @add_label %>
    </button>
  </div>
<% end %>
