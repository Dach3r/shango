<div data-key-value-table-target="row" class="<%= class_names("group flex items-center", "gap-2 px-3": !pairs?, "items-stretch divide-x divide-line": pairs?, "py-1": !pairs? && variant != :variables, "flex-wrap gap-y-1 py-2": variant == :variables) %>">
  <% if persisted? %>
    <%= hidden_field_tag field_name("id"), row["id"], id: nil %>
    <%= hidden_field_tag field_name("_destroy"), "0", id: nil, data: { destroy: true } %>
  <% end %>

  <% unless pairs? %>
    <%= render Checkbox::Component.new(name: field_name("enabled"), checked: enabled?, data: { field: "enabled", action: "change->key-value-table#input" },
                                       aria: { label: t("components.key_value_table.enabled") }) %>
  <% end %>

  <% if pairs? %>
    <div class="min-w-0 flex-1 px-2 py-1">
      <%= text_field_tag field_name("key"), row["key"], id: nil, placeholder: @key_placeholder, autocomplete: "off", spellcheck: false,
                         data: { field: "key", action: "input->key-value-table#input" }, class: cell_classes("font-mono text-xs") %>
    </div>
  <% else %>
    <%= text_field_tag field_name("key"), row["key"], id: nil, placeholder: @key_placeholder, autocomplete: "off", spellcheck: false,
                       data: { field: "key", action: "input->key-value-table#input" }, class: cell_classes("min-w-0 flex-1 font-mono text-xs") %>
  <% end %>

  <% if variant == :form_data %>
    <%= hidden_field_tag field_name("upload_token"), upload_token, id: nil %>
    <%= hidden_field_tag field_name("attachment_id"), row["attachment_id"], id: nil if row["attachment_id"].present? %>
    <%= render Select::Component.new(name: field_name("type"), options: [[t("components.key_value_table.text"), "text"], [t("components.key_value_table.file"), "file"]], value: row["type"] || "text",
                                     input_data: { role: "type", action: "change->key-value-table#typeChanged" }, class: "w-24 shrink-0 !px-2") %>
    <div data-role="text" class="min-w-0 flex-1" <%= "hidden" if file? %>>
      <%= text_field_tag field_name("value"), row["value"], id: nil, placeholder: @value_placeholder, autocomplete: "off", disabled: file?,
                         data: { field: "value", action: "input->key-value-table#input" }, class: cell_classes("font-mono text-xs") %>
    </div>
    <div data-role="file" class="min-w-0 flex-1" <%= "hidden" unless file? %>>
      <%= hidden_field_tag field_name("value"), row["value"], id: nil, disabled: !file? %>
      <%= file_field_tag upload_name, id: nil, disabled: !file?, data: { action: "change->key-value-table#input" },
                         class: field_classes("text-xs file:mr-3 file:border-0 file:bg-accent/10 file:px-2 file:py-1 file:text-xs file:font-medium file:text-accent") %>
      <% if file? && row["value"].present? %>
        <p class="mt-1 truncate text-xs text-muted"><%= row["value"] %></p>
      <% end %>
    </div>
  <% else %>
    <% if pairs? %>
      <div class="min-w-0 flex-[1.4] px-2 py-1">
        <%= text_field_tag field_name("value"), value_text, id: nil, type: value_type, placeholder: value_hint, autocomplete: "off", spellcheck: false,
                           data: { field: "value", action: "input->key-value-table#input" }, class: cell_classes("font-mono text-xs") %>
      </div>
    <% else %>
      <%= text_field_tag field_name("value"), value_text, id: nil, type: value_type, placeholder: value_hint, autocomplete: "off", spellcheck: false,
                         data: { field: "value", action: "input->key-value-table#input" }, class: cell_classes(variant == :variables ? "order-last w-full basis-full" : "min-w-0 flex-[1.4]") + " font-mono text-xs" %>
    <% end %>
  <% end %>

  <% if pairs? %>
    <div class="hidden min-w-0 flex-1 px-2 py-1 lg:block">
      <%= text_field_tag field_name("description"), row["description"], id: nil, placeholder: t("components.key_value_table.description"), autocomplete: "off",
                         data: { field: "description" }, class: cell_classes("text-xs") %>
    </div>
  <% end %>

  <% if variant == :variables %>
    <%= render Checkbox::Component.new(name: field_name("secret"), checked: secret?, label: t("components.key_value_table.secret"), label_class: "shrink-0 !gap-1.5 text-xs text-muted",
                                       data: { action: "change->key-value-table#syncMask" }) %>
  <% end %>

  <% if pairs? %>
    <div class="flex w-[5.25rem] shrink-0 items-center gap-2 px-3">
      <%= render Checkbox::Component.new(name: field_name("enabled"), checked: enabled?, data: { field: "enabled", action: "change->key-value-table#input" },
                                         aria: { label: t("components.key_value_table.enabled") }) %>
      <button type="button" data-action="key-value-table#remove" aria-label="<%= t("components.key_value_table.remove") %>"
              class="[.group:only-child_&]:invisible flex size-8 shrink-0 cursor-pointer items-center justify-center text-faint opacity-0 transition hover:bg-field group-hover:opacity-100 focus-visible:opacity-100 max-lg:opacity-100 hover:text-danger focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50">
        <%= lucide_icon "trash-2", class: "size-4" %>
      </button>
    </div>
  <% else %>
    <button type="button" data-action="key-value-table#remove" aria-label="<%= t("components.key_value_table.remove") %>"
            class="flex size-8 shrink-0 cursor-pointer items-center justify-center text-faint opacity-0 transition hover:bg-field group-hover:opacity-100 focus-visible:opacity-100 max-lg:opacity-100 hover:text-danger focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50">
      <%= lucide_icon "trash-2", class: "size-4" %>
    </button>
  <% end %>
</div>
