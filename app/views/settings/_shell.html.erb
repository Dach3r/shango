<% content_for :main_class, "flex min-h-0 flex-1 px-4 py-8 sm:px-8" %>

<div class="mx-auto flex w-full max-w-6xl flex-col self-start border border-line bg-card md:min-h-[36rem] md:flex-row">
  <aside class="shrink-0 border-b border-line md:w-60 md:border-r md:border-b-0">
    <%= render SettingsNav::Component.new(project: current_project) %>
  </aside>

  <section class="flex min-w-0 flex-1 flex-col">
    <header class="border-b border-line px-5 py-5 sm:px-7">
      <h1 class="text-base font-semibold text-ink"><%= heading %></h1>
      <p class="mt-1 text-sm text-muted"><%= description %></p>
    </header>

    <%= yield %>
  </section>
</div>
