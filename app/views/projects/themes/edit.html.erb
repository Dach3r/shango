<% content_for :title, "#{t(".title")} · #{ApplicationHelper::CONFIG[:name]}" %>

<%= render layout: "settings/shell", locals: { heading: t(".heading"), description: t(".description") } do %>
  <%= form_with model: @membership, url: theme_path, method: :patch, data: { controller: "theme-preview" } do |form| %>
    <%= render "workbench/shared/errors", record: @membership %>

    <div class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-card">
      <fieldset class="grid gap-4 p-5 md:grid-cols-[1fr_21rem] md:items-center md:gap-8">
        <div class="min-w-0">
          <legend class="float-left w-full text-sm font-semibold text-ink"><%= t("projects.themes.edit.color_scheme.label") %></legend>
          <p class="mt-1 clear-both text-xs leading-relaxed text-muted"><%= t("projects.themes.edit.color_scheme.hint") %></p>
        </div>

        <div class="grid grid-cols-3 gap-1 rounded-xl border border-line bg-field p-1">
          <% { system: "monitor", light: "sun", dark: "moon" }.each do |value, icon| %>
            <label class="flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-transparent px-2 py-2 text-sm text-muted transition hover:text-ink has-[:checked]:border-solid/60 has-[:checked]:bg-solid/10 has-[:checked]:text-ink has-[:focus-visible]:ring-4 has-[:focus-visible]:ring-solid/30">
              <%= form.radio_button :color_scheme, value, class: "sr-only", data: { action: "theme-preview#apply" } %>
              <%= lucide_icon icon, class: "size-4 shrink-0", "aria-hidden": true %>
              <span><%= t("projects.themes.edit.color_schemes.#{value}") %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <fieldset class="p-5">
        <legend class="float-left w-full text-sm font-semibold text-ink"><%= t("projects.themes.edit.theme.label") %></legend>
        <p class="mt-1 clear-both text-xs leading-relaxed text-muted"><%= t("projects.themes.edit.theme.hint") %></p>

        <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          <% Membership::THEMES.each_key do |theme| %>
            <%= render ThemePreview::Component.new(form:, theme:) %>
          <% end %>
        </div>
      </fieldset>
    </div>
  <% end %>
<% end %>
