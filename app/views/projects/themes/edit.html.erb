<% content_for :title, "#{t(".title")} · #{ApplicationHelper::CONFIG[:name]}" %>

<%= render layout: "settings/shell", locals: { icon: "palette", heading: t(".heading"), description: t(".description") } do %>
  <%= form_with model: @membership, url: theme_path, method: :patch, data: { controller: "theme-preview" } do |form| %>
    <%= render "workbench/shared/errors", record: @membership %>

    <% pinned = Membership.pinned_scheme(@membership.theme).present? %>
    <div class="divide-y divide-line">
      <fieldset class="grid gap-4 px-5 py-5 sm:px-7 md:grid-cols-[1fr_21rem] md:items-center md:gap-8">
        <div class="min-w-0">
          <legend class="float-left w-full text-sm font-semibold text-ink"><%= t("projects.themes.edit.color_scheme.label") %></legend>
          <p class="mt-1 clear-both text-xs leading-relaxed text-muted"><%= t("projects.themes.edit.color_scheme.hint") %></p>
        </div>

        <div class="grid grid-cols-3 gap-1 border border-line bg-field p-1" data-theme-preview-target="schemes">
          <% { system: "monitor", light: "sun", dark: "moon" }.each do |value, icon| %>
            <label class="flex cursor-pointer items-center justify-center gap-2 border border-transparent px-2 py-2 text-sm text-muted transition hover:text-ink has-[:checked]:border-solid/60 has-[:checked]:bg-solid/10 has-[:checked]:text-ink has-[:focus-visible]:ring-1 has-[:focus-visible]:ring-solid has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-50">
              <%= form.radio_button :color_scheme, value, class: "sr-only", disabled: pinned, data: { action: "theme-preview#apply" } %>
              <%= lucide_icon icon, class: "size-4 shrink-0", "aria-hidden": true %>
              <span><%= t("projects.themes.edit.color_schemes.#{value}") %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <% groups = { accents: Membership::ACCENT_THEMES, styles: Membership::STYLE_THEMES, omarchy: Membership::OMARCHY_THEMES } %>
      <% active_group = groups.key(groups.values.find { |themes| themes.include?(@membership.theme) }) %>
      <fieldset class="py-5" data-controller="tabs" data-tabs-active-value="<%= active_group %>">
        <div class="px-5 sm:px-7">
          <legend class="float-left w-full text-sm font-semibold text-ink"><%= t("projects.themes.edit.theme.label") %></legend>
          <p class="mt-1 clear-both text-xs leading-relaxed text-muted"><%= t("projects.themes.edit.theme.hint") %></p>
        </div>

        <div class="mt-4 px-5 sm:px-7 [&>div]:px-0">
          <%= render TabBar::Component.new(items: groups.keys.map { |group| { name: group.to_s, label: t("projects.themes.edit.groups.#{group}") } }, label: t("projects.themes.edit.theme.label")) do %>
            <div data-tabs-target="panel" data-name="omarchy credits" class="self-end" hidden>
              <button type="button" role="tab" class="<%= TabBar::Component::TAB %>" data-tabs-target="tab" data-name="credits"
                      data-action="tabs#select" data-tabs-name-param="credits">
                <%= lucide_icon "heart", class: "size-3.5 shrink-0", "aria-hidden": true %>
                <%= t("projects.themes.edit.credits.label") %>
              </button>
            </div>
          <% end %>
        </div>

        <% groups.each do |group, themes| %>
          <div data-tabs-target="panel" data-name="<%= group %>" class="mt-4 px-5 sm:px-7" hidden>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
              <% themes.each do |theme| %>
                <%= render ThemePreview::Component.new(form:, theme:) %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div data-tabs-target="panel" data-name="credits" class="mt-4 px-5 sm:px-7" hidden>
          <p class="text-xs leading-relaxed text-muted"><%= t("projects.themes.edit.credits.hint") %></p>
          <ul class="mt-4 divide-y divide-line border border-line">
            <% Membership::OMARCHY_CREDITS.each do |credit| %>
              <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
                <div data-palette="<%= credit[:key] %>" aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center border border-line bg-page">
                  <span class="size-3 bg-solid"></span>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-medium text-ink"><%= t("projects.themes.edit.themes.#{credit[:key]}") %></p>
                  <p class="truncate text-xs text-muted"><%= t("projects.themes.edit.credits.by", author: credit[:author]) %></p>
                </div>
                <span class="inline-flex items-center border border-line px-2 py-0.5 text-xs font-medium text-body"><%= credit[:license] || t("projects.themes.edit.credits.no_license") %></span>
                <%= link_to credit[:repository], target: "_blank", rel: "noopener noreferrer",
                            class: "inline-flex items-center gap-1.5 text-xs font-medium text-accent transition hover:text-accent-hover focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
                  <%= lucide_icon "external-link", class: "size-3.5 shrink-0", "aria-hidden": true %>
                  <%= t("projects.themes.edit.credits.repository") %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </fieldset>
    </div>
  <% end %>
<% end %>
