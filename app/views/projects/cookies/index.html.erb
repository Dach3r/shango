<%= turbo_frame_tag "modal" do %>
  <%= render Modal::Component.new(icon: "cookie", title: t("projects.cookies.index.title"), description: t("projects.cookies.index.intro"), size: :lg) do %>
  <section class="space-y-4">
    <p class="text-xs font-medium text-body"><%= t("projects.cookies.index.scope", name: current_environment&.name || t("projects.cookies.index.scope_none")) %></p>

    <% if @cookies.empty? %>
      <%= render EmptyState::Component.new(icon: "cookie", title: t("projects.cookies.index.empty_title"), description: t("projects.cookies.index.empty_hint")) %>
    <% else %>
      <ul class="space-y-3">
        <% @cookies.each do |cookie| %>
          <li class="flex items-center gap-3 border border-line py-3 pr-2 pl-4">
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-ink" title="<%= cookie.name %>"><%= cookie.name %></p>
              <p class="mt-0.5 truncate text-xs text-muted"><%= cookie.domain %><%= cookie.path %></p>
              <p class="mt-0.5 text-xs text-faint">
                <%= cookie.expires_at ? t("projects.cookies.index.expires", date: l(cookie.expires_at, format: :short)) : t("projects.cookies.index.session") %><%= " · #{t("projects.cookies.index.secure")}" if cookie.secure %><%= " · #{t("projects.cookies.index.http_only")}" if cookie.http_only %>
              </p>
            </div>
            <%= link_to edit_cookie_path(cookie), title: t("projects.cookies.index.edit"), aria: { label: t("projects.cookies.index.edit") },
                        class: "flex size-10 shrink-0 items-center justify-center text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %><%= lucide_icon "pencil", class: "size-4" %><% end %>
            <%= button_to cookie_path(cookie), method: :delete, form_class: "contents", form: { data: { turbo_confirm: t("projects.cookies.index.confirm_delete", name: cookie.name) } }, title: t("projects.cookies.index.delete"), aria: { label: t("projects.cookies.index.delete") },
                          class: "flex size-10 shrink-0 cursor-pointer items-center justify-center text-muted transition hover:bg-danger/10 hover:text-danger focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %><%= lucide_icon "trash-2", class: "size-4" %><% end %>
          </li>
        <% end %>
      </ul>
      <%= button_to cookie_jar_path, method: :delete, form_class: "contents", form: { data: { turbo_confirm: t("projects.cookies.index.confirm_clear") } },
                    class: "flex w-full cursor-pointer items-center justify-center gap-2 border border-line px-3 py-3 text-sm font-medium text-danger transition hover:bg-danger/10 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %><%= lucide_icon "trash-2", class: "size-4" %><%= t("projects.cookies.index.clear") %><% end %>
    <% end %>

    <%= link_to new_cookie_path, class: "flex w-full items-center justify-center gap-2 border border-dashed border-line px-3 py-3 text-sm font-medium text-muted transition hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %><%= lucide_icon "plus", class: "size-4" %><%= t("projects.cookies.index.new") %><% end %>
  </section>
  <% end %>
<% end %>
