<%# Says which environment narrows the monitors and incidents on a page, with the way to widen or narrow it. Needs `scope_environment`; renders nothing when the member has no environment selected. %>
<% if current_environment %>
  <p class="flex shrink-0 flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-line bg-card px-5 py-2 text-xs text-muted">
    <% if scope_environment %>
      <span><%= t("projects.environment_scope.narrowed", environment: current_environment.name) %></span>
      <%= link_to t("projects.environment_scope.show_all"), environment_scope_path(all: true), class: "font-mono uppercase tracking-wide text-faint transition hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" %>
    <% else %>
      <span><%= t("projects.environment_scope.all") %></span>
      <%= link_to t("projects.environment_scope.only", environment: current_environment.name), environment_scope_path(all: false), class: "font-mono uppercase tracking-wide text-faint transition hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" %>
    <% end %>
  </p>
<% end %>
