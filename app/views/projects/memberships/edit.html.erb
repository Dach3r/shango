<% content_for :title, "#{t(".title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% content_for :main_class, "flex min-h-0 flex-1" %>

<div class="flex min-h-[calc(100vh-2.5rem)] w-full flex-col md:flex-row">
  <aside class="shrink-0 border-b border-line bg-card px-2 py-4 md:w-72 md:border-r md:border-b-0">
    <%= render SettingsNav::Component.new(project: current_project) %>
  </aside>

  <div class="min-w-0 flex-1 overflow-y-auto px-4 py-8 sm:px-8">
    <h1 class="mx-auto mb-6 max-w-3xl truncate text-lg font-semibold tracking-tight text-ink"><%= t(".title") %></h1>

    <section class="mx-auto min-w-0 max-w-3xl">
      <header class="mb-4">
        <h2 class="text-base font-semibold text-ink"><%= t(".heading") %></h2>
        <p class="mt-1 text-sm text-muted"><%= t(".description") %></p>
      </header>

      <%= form_with model: @membership, url: membership_path, method: :patch, class: "space-y-6 rounded-2xl border border-line bg-card p-6" do |form| %>
        <%= render "workbench/shared/errors", record: @membership %>

        <% %i[folder_toggle request_open].each do |setting| %>
          <fieldset>
            <legend class="text-sm font-semibold text-ink"><%= t(".#{setting}.label") %></legend>
            <p class="mt-1 mb-3 text-xs text-muted"><%= t(".#{setting}.hint") %></p>
            <div class="space-y-2">
              <% Membership::CLICK_MODES.each_key do |value| %>
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-line bg-field px-3 py-2 text-sm text-ink has-[:checked]:border-solid">
                  <%= form.radio_button setting, value, class: "mt-0.5 accent-[var(--color-solid)]" %>
                  <span><%= t(".modes.#{value}") %></span>
                </label>
              <% end %>
            </div>
          </fieldset>
        <% end %>

        <div class="flex justify-end">
          <%= form.submit t("workbench.shared.save"), class: button_classes(:primary) %>
        </div>
      <% end %>
    </section>
  </div>
</div>
