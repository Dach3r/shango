<% persisted = @environment.persisted? %>
<%= render Modal::Component.new(icon: "layers", title: persisted ? @environment.name_was : t("projects.environments.new.title"), description: persisted ? nil : t("projects.environments.new.subtitle"), size: :xl) do |modal| %>
  <% modal.with_footer do %>
    <%= link_to environments_path, class: button_classes(:ghost) do %><%= lucide_icon "x", class: "size-4 shrink-0" %><%= t("workbench.shared.cancel") %><% end %>
    <%= tag.button type: "submit", form: "environment_form", class: button_classes(:primary) do %><%= lucide_icon persisted ? "save" : "plus", class: "size-4 shrink-0" %><%= persisted ? t("workbench.shared.save") : t("projects.environments.new.submit") %><% end %>
  <% end %>
  <%= form_with model: @environment, url: (persisted ? environment_path(@environment) : environments_path), id: "environment_form", class: "space-y-6" do |form| %>
    <%= render "workbench/shared/errors", record: @environment %>

    <div>
      <%= form.label :name, t("projects.environments.form.name"), class: label_classes %>
      <%= form.text_field :name, autofocus: true, autocomplete: "off", placeholder: t("projects.environments.form.name_placeholder"), class: field_classes %>
      <% unless persisted %><p class="mt-1 text-xs text-faint"><%= t("projects.environments.new.name_hint") %></p><% end %>
    </div>

    <div>
      <div class="mb-2 flex items-center gap-2">
        <%= lucide_icon "braces", class: "size-4 text-muted" %>
        <h2 class="text-xs font-medium text-muted"><%= t("projects.environments.form.variables") %></h2>
      </div>
      <%= render KeyValueTable::Component.new(name: "environment[variables_attributes]", rows: @environment.variables, variant: :variables,
                                              key_placeholder: t("projects.environments.form.key_placeholder"), value_placeholder: t("projects.environments.form.value_placeholder")) %>
      <p class="mt-2 flex items-start gap-2 text-xs leading-relaxed text-faint">
        <%= lucide_icon "lock", class: "mt-0.5 size-3.5 shrink-0" %>
        <span><%= t("projects.environments.form.variables_hint") %></span>
      </p>
    </div>
  <% end %>
<% end %>
