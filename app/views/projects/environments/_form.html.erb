<%= form_with model: @environment, url: environment_path(@environment), class: "flex min-h-full flex-col" do |form| %>
  <% if turbo_frame_request? %>
    <div class="mb-5 flex items-center gap-2">
      <%= link_to environments_path, aria: { label: t("workbench.shared.cancel") }, class: "-ml-2 flex size-8 shrink-0 items-center justify-center text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %><%= lucide_icon "arrow-left", class: "size-4" %><% end %>
      <h3 class="truncate text-sm font-semibold text-ink"><%= @environment.name_was %></h3>
    </div>
  <% end %>

  <div class="flex-1 space-y-6">
    <%= render "workbench/shared/errors", record: @environment %>

    <div>
      <%= form.label :name, t(".name"), class: label_classes %>
      <%= form.text_field :name, autocomplete: "off", placeholder: t(".name_placeholder"), class: field_classes %>
    </div>

    <div>
      <div class="mb-2 flex items-baseline justify-between gap-2">
        <h2 class="text-xs font-medium text-muted"><%= t(".variables") %></h2>
      </div>
      <%= render KeyValueTable::Component.new(name: "environment[variables_attributes]", rows: @environment.variables, variant: :variables,
                                              key_placeholder: t(".key_placeholder"), value_placeholder: t(".value_placeholder")) %>
      <p class="mt-2 text-xs text-faint"><%= t(".variables_hint") %></p>
    </div>
  </div>

  <div class="sticky -bottom-4 -mx-4 -mb-4 mt-6 flex justify-end gap-2 border-t border-line bg-card px-4 py-3">
    <%= link_to environments_path, class: button_classes(:ghost) do %><%= lucide_icon "x", class: "size-4 shrink-0" %><%= t("workbench.shared.cancel") %><% end %>
    <%= form.button type: :submit, class: button_classes(:primary) do %><%= lucide_icon "save", class: "size-4 shrink-0" %><%= t("workbench.shared.save") %><% end %>
  </div>
<% end %>
