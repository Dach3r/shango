<% content_for :title, "#{t(".title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% content_for :heading, t(".title") %>


<%= render layout: "projects/environments/panel" do %>
  <section class="mx-auto max-w-3xl space-y-4">
    <p class="text-xs leading-relaxed text-muted"><%= t("projects.environments.index.intro") %></p>

    <% if @environments.empty? %>
      <div class="rounded-2xl border border-dashed border-line p-8 text-center">
        <%= lucide_icon "layers", class: "mx-auto size-8 text-faint" %>
        <p class="mt-3 text-sm font-medium text-ink"><%= t("projects.environments.index.empty_title") %></p>
        <p class="mt-1 text-sm text-muted"><%= t("projects.environments.index.empty_hint") %></p>
      </div>
    <% else %>
      <ul class="space-y-1.5">
        <% @environments.each do |environment| %>
          <% active = environment == current_environment %>
          <li class="<%= class_names("group flex items-center gap-3 rounded-xl border px-3 py-2.5 transition", "border-accent/40 bg-accent/5": active, "border-line bg-card hover:bg-field": !active) %>">
            <span class="<%= class_names("flex size-8 shrink-0 items-center justify-center rounded-lg", "bg-accent/10 text-accent": active, "bg-field text-muted": !active) %>"><%= lucide_icon "layers", class: "size-4" %></span>
            <div class="min-w-0 flex-1">
              <p class="flex items-center gap-2 text-sm font-medium text-ink">
                <span class="truncate"><%= environment.name %></span>
                <% if active %><span class="shrink-0 rounded-full bg-accent/15 px-1.5 py-0.5 text-[10px] font-medium text-accent"><%= t("projects.environments.index.selected") %></span><% end %>
              </p>
              <p class="text-xs text-muted"><%= t("projects.environments.index.variables", count: environment.variables.size) %></p>
            </div>
            <div class="flex shrink-0 items-center">
              <%= link_to edit_environment_path(environment), title: t("projects.environments.index.edit"), aria_label: t("projects.environments.index.edit"), class: "flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50" do %><%= lucide_icon "pencil", class: "size-4" %><% end %>
              <%= button_to environment_path(environment), method: :delete, title: t("projects.environments.index.delete"), aria_label: t("projects.environments.index.delete"), class: "flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50 hover:!text-danger", form_class: "contents",
                            form: { data: { turbo_confirm: t("projects.environments.index.confirm_delete", name: environment.name) } } do %><%= lucide_icon "trash-2", class: "size-4" %><% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= link_to new_environment_path, class: "flex w-full items-center justify-center gap-2 rounded-xl border border-dashed border-line px-3 py-2.5 text-sm font-medium text-muted transition hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50" do %><%= lucide_icon "plus", class: "size-4" %><%= t("projects.environments.index.new") %><% end %>
  </section>
<% end %>
