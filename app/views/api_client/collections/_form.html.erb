<%= render Modal::Component.new(icon: "library", title: @collection.persisted? ? t(".edit_title") : t(".new_title"), size: :lg, form: "collection_form", submit: t("api_client.shared.save")) do %>
  <%= form_with model: @collection, scope: :collection, url: (@collection.persisted? ? api_client_collection_path(@collection) : api_client_collections_path),
                id: "collection_form", data: { turbo_frame: "_top" }, class: "space-y-5" do |form| %>
    <%= render "api_client/shared/errors", record: @collection %>

    <%= render Input::Component.new(form: form, attribute: :name, label: t(".name"), icon: "library", placeholder: t(".name_placeholder"), autofocus: true, autocomplete: "off") %>
    <%= render Input::Component.new(form: form, attribute: :description, label: t(".description"), type: :text_area, rows: 2) %>
  <% end %>
<% end %>
