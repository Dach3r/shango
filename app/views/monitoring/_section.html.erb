<%# One section of a Monitoring form: a heading band with its icon and title, then the optional `hint:` and the block. Render with `render layout: "monitoring/section", locals: { title:, icon:, hint: }` (`hint:` optional). %>
<section class="border-b border-line last:border-b-0">
  <h2 class="flex h-10 items-center gap-2 border-b border-line bg-card px-5 font-mono text-xs uppercase tracking-wide text-faint lg:px-8"><%= lucide_icon icon, class: "size-3.5" %><%= title %></h2>
  <div class="flex max-w-3xl min-w-0 flex-col gap-5 px-5 py-6 lg:px-8">
    <% if local_assigns[:hint].present? %><p class="text-sm leading-relaxed text-muted"><%= hint %></p><% end %>
    <%= yield %>
  </div>
</section>
