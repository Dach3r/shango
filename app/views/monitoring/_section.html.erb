<%# One section of a Monitoring form: its icon, title and optional `hint:` on the left, the block on the right. Render with `render layout: "monitoring/section", locals: { title:, icon:, hint: }` (`hint:` optional). %>
<section class="grid gap-x-12 gap-y-5 border-b border-line px-5 py-8 lg:grid-cols-[18rem_minmax(0,40rem)] lg:px-8">
  <div class="flex min-w-0 gap-4 lg:flex-col lg:gap-3">
    <span class="flex size-10 shrink-0 items-center justify-center border border-line text-muted"><%= lucide_icon icon, class: "size-4" %></span>
    <div class="min-w-0">
      <h2 class="text-base font-semibold text-ink"><%= title %></h2>
      <% if local_assigns[:hint].present? %><p class="mt-1.5 text-sm leading-relaxed text-muted"><%= hint %></p><% end %>
    </div>
  </div>
  <div class="flex min-w-0 flex-col gap-5"><%= yield %></div>
</section>
