<%# Cancel and save of the channel form, for the page bar (the button submits the form by its id). Render with `channel:`. %>
<%= link_to t("monitoring.form.cancel"), monitoring_channels_path, class: button_classes(:secondary) %>
<%= button_tag type: :submit, form: "channel_form", class: button_classes(:primary) do %><%= lucide_icon "check", class: "size-4" %><%= t(channel.persisted? ? "monitoring.channels.form.save" : "monitoring.channels.form.create") %><% end %>
