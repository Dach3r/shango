<% content_for :title, "#{t("monitoring.channels.edit.title")} · #{ApplicationHelper::CONFIG[:name]}" %>

<%= render layout: "monitoring/shell", locals: { current: :channels } do %>
  <%= render layout: "monitoring/page_bar", locals: { back: monitoring_channels_path, title: t("monitoring.channels.edit.title"), detail: @channel.name_was } do %>
    <%= render "monitoring/channels/submit", channel: @channel %>
  <% end %>
  <div class="min-h-0 flex-1 overflow-y-auto">
    <%= render "monitoring/channels/form", channel: @channel %>
  </div>
<% end %>
