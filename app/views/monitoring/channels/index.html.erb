<% content_for :title, "#{t("monitoring.channels.index.title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% label = "font-mono text-xs uppercase tracking-wide text-faint" %>

<div class="mx-auto flex max-w-6xl flex-col gap-6">
  <%= render "monitoring/tabs", current: :channels %>

  <header class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0">
      <h1 class="truncate text-lg font-semibold tracking-tight text-ink"><%= t("monitoring.channels.index.title") %></h1>
      <p class="mt-1 text-sm text-muted"><%= t("monitoring.channels.index.description") %></p>
    </div>
    <% if policy(current_project.notification_channels.new).create? %>
      <%= link_to new_monitoring_channel_path, class: button_classes(:primary) do %><%= lucide_icon "plus", class: "size-4" %><%= t("monitoring.channels.index.new") %><% end %>
    <% end %>
  </header>

  <% if @revealed %>
    <div role="status" class="flex flex-col gap-2 border border-accent/40 bg-accent/10 p-4" data-controller="clipboard" data-clipboard-text-value="<%= @revealed.signing_secret %>">
      <p class="text-sm font-medium text-ink"><%= t("monitoring.channels.index.secret_title", name: @revealed.name) %></p>
      <p class="text-xs text-muted"><%= t("monitoring.channels.index.secret_hint") %></p>
      <div class="flex items-center gap-2">
        <code class="min-w-0 flex-1 truncate border border-line bg-field px-3 py-2 font-mono text-xs text-ink"><%= @revealed.signing_secret %></code>
        <button type="button" class="<%= button_classes(:secondary) %>" data-action="clipboard#copy">
          <span data-clipboard-target="copy" class="inline-flex items-center gap-1.5"><%= lucide_icon "copy", class: "size-3.5" %><%= t("monitoring.channels.index.copy") %></span>
          <span data-clipboard-target="done" class="hidden items-center gap-1.5"><%= lucide_icon "check", class: "size-3.5" %><%= t("monitoring.channels.index.copied") %></span>
        </button>
      </div>
    </div>
  <% end %>

  <% if @channels.empty? %>
    <div class="flex flex-col items-center justify-center gap-3 border border-line bg-card px-6 py-16 text-center">
      <%= lucide_icon "bell", class: "size-8 text-faint" %>
      <p class="text-sm font-medium text-ink"><%= t("monitoring.channels.index.empty") %></p>
      <p class="max-w-sm text-sm text-muted"><%= t("monitoring.channels.index.empty_hint") %></p>
    </div>
  <% else %>
    <ul class="divide-y divide-line border border-line bg-card">
      <% @channels.each do |channel| %>
        <% latest = @latest[channel.id] %>
        <li class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex min-w-0 flex-col gap-1">
            <p class="flex flex-wrap items-center gap-2 text-sm font-medium text-ink">
              <%= lucide_icon channel_icon(channel), class: "size-4 text-muted" %>
              <span class="truncate"><%= channel.name %></span>
              <span class="<%= label %>"><%= t("monitoring.channels.kinds.#{channel.kind}") %></span>
              <% unless channel.enabled %><span class="border border-line px-1.5 py-0.5 font-mono text-[0.625rem] uppercase tracking-wide text-muted"><%= t("monitoring.channels.index.disabled") %></span><% end %>
            </p>
            <p class="truncate font-mono text-xs text-muted"><%= channel.masked_target %></p>
            <p class="text-xs text-muted">
              <%= t("monitoring.channels.index.monitors", count: channel.uptime_monitors.size) %>
              <% if latest %>
                · <%= t("monitoring.channels.index.latest.#{latest.status}", time: time_ago_in_words(latest.created_at)) %>
                <% if latest.error %><span class="text-danger"><%= channel_delivery_error(latest) %></span><% end %>
              <% end %>
            </p>
          </div>
          <% if policy(channel).update? %>
            <div class="flex flex-wrap gap-2">
              <%= button_to monitoring_channel_test_path(channel), form_class: "contents", class: button_classes(:secondary) do %><%= lucide_icon "send", class: "size-3.5" %><%= t("monitoring.channels.actions.test") %><% end %>
              <% if channel.webhook? %>
                <%= button_to monitoring_channel_secret_path(channel), form_class: "contents", form: { data: { turbo_confirm: t("monitoring.channels.actions.confirm_secret") } }, class: button_classes(:secondary) do %><%= lucide_icon "key-round", class: "size-3.5" %><%= t("monitoring.channels.actions.secret") %><% end %>
              <% end %>
              <%= link_to edit_monitoring_channel_path(channel), class: button_classes(:secondary) do %><%= lucide_icon "pencil", class: "size-3.5" %><%= t("monitoring.actions.edit") %><% end %>
              <%= button_to monitoring_channel_path(channel), method: :delete, form_class: "contents", form: { data: { turbo_confirm: t("monitoring.channels.actions.confirm_delete", name: channel.name) } }, class: button_classes(:danger) do %><%= lucide_icon "trash-2", class: "size-3.5" %><%= t("monitoring.actions.delete") %><% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
