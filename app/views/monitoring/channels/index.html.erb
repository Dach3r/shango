<% content_for :title, "#{t("monitoring.channels.index.title")} · #{ApplicationHelper::CONFIG[:name]}" %>

<%= render layout: "monitoring/shell", locals: { current: :channels } do %>
  <div class="flex h-14 shrink-0 items-stretch justify-between gap-4 border-b border-line">
    <h1 class="flex min-w-0 items-center gap-2.5 truncate px-5 text-sm font-semibold text-ink"><%= lucide_icon "bell", class: "size-4 text-muted" %><%= t("monitoring.channels.index.title") %></h1>
    <% if policy(current_project.notification_channels.new).create? %>
      <%= link_to new_monitoring_channel_path, class: button_classes(:primary, "shrink-0 px-5 sm:w-44") do %><%= lucide_icon "plus", class: "size-4" %><%= t("monitoring.channels.index.new") %><% end %>
    <% end %>
  </div>

  <section class="flex min-h-0 min-w-0 flex-1 flex-col overflow-y-auto">
    <% if @revealed %>
      <div role="status" class="flex shrink-0 flex-col gap-3 border-b border-accent/40 bg-accent/10 px-5 py-4" data-controller="clipboard" data-clipboard-text-value="<%= @revealed.signing_secret %>">
        <div>
          <p class="text-sm font-medium text-ink"><%= t("monitoring.channels.index.secret_title", name: @revealed.name) %></p>
          <p class="mt-1 text-xs text-muted"><%= t("monitoring.channels.index.secret_hint") %></p>
        </div>
        <div class="flex items-stretch">
          <code class="min-w-0 flex-1 truncate border border-line bg-field px-3 py-2 font-mono text-xs text-ink"><%= @revealed.signing_secret %></code>
          <button type="button" class="<%= button_classes(:secondary, "-ml-px") %>" data-action="clipboard#copy">
            <span data-clipboard-target="copy" class="inline-flex items-center gap-1.5"><%= lucide_icon "copy", class: "size-3.5" %><%= t("monitoring.channels.index.copy") %></span>
            <span data-clipboard-target="done" class="hidden items-center gap-1.5"><%= lucide_icon "check", class: "size-3.5" %><%= t("monitoring.channels.index.copied") %></span>
          </button>
        </div>
      </div>
    <% end %>

    <% if @channels.empty? %>
      <%= render EmptyState::Component.new(icon: "bell", title: t("monitoring.channels.index.empty"), description: t("monitoring.channels.index.empty_hint")) %>
    <% else %>
      <ul>
        <% @channels.each do |channel| %>
          <% latest = @latest[channel.id] %>
          <li class="flex flex-col gap-3 border-b border-line px-5 py-3.5 transition hover:bg-card sm:flex-row sm:items-center sm:justify-between">
            <div class="flex min-w-0 items-center gap-3">
              <span class="flex size-8 shrink-0 items-center justify-center border border-line text-muted" title="<%= t("monitoring.channels.kinds.#{channel.kind}") %>"><%= lucide_icon channel_icon(channel), class: "size-4" %></span>
              <div class="flex min-w-0 flex-col gap-0.5">
                <p class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
                  <span class="truncate text-sm font-semibold text-ink"><%= channel.name %></span>
                  <span class="font-mono text-[0.6875rem] uppercase tracking-wide text-faint"><%= t("monitoring.channels.kinds.#{channel.kind}") %></span>
                  <% unless channel.enabled %><span class="border border-line px-1.5 py-0.5 font-mono text-[0.625rem] uppercase tracking-wide text-muted"><%= t("monitoring.channels.index.disabled") %></span><% end %>
                </p>
                <p class="truncate font-mono text-xs text-faint"><%= channel.masked_target %></p>
                <p class="text-xs text-muted">
                  <%= t("monitoring.channels.index.monitors", count: channel.uptime_monitors.size) %>
                  <% if latest %>
                    · <%= t("monitoring.channels.index.latest.#{latest.status}", time: time_ago_in_words(latest.created_at)) %>
                    <% if latest.error %><span class="text-danger"><%= channel_delivery_error(latest) %></span><% end %>
                  <% end %>
                </p>
              </div>
            </div>
            <% if policy(channel).update? %>
              <div class="flex shrink-0 items-center justify-end">
                <%= button_to monitoring_channel_test_path(channel), form_class: "contents", **monitor_action(:test, compact: true, label: t("monitoring.channels.actions.test")) do %><%= lucide_icon "send", class: "size-3.5" %><% end %>
                <% if channel.webhook? %>
                  <%= button_to monitoring_channel_secret_path(channel), form_class: "contents", form: { data: { turbo_confirm: t("monitoring.channels.actions.confirm_secret") } },
                        **monitor_action(:secret, compact: true, label: t("monitoring.channels.actions.secret")) do %><%= lucide_icon "key-round", class: "size-3.5" %><% end %>
                <% end %>
                <%= link_to edit_monitoring_channel_path(channel), **monitor_action(:edit, compact: true) do %><%= lucide_icon "pencil", class: "size-3.5" %><% end %>
                <%= button_to monitoring_channel_path(channel), method: :delete, form_class: "contents", form: { data: { turbo_confirm: t("monitoring.channels.actions.confirm_delete", name: channel.name) } },
                      **monitor_action(:delete, compact: true, danger: true) do %><%= lucide_icon "trash-2", class: "size-3.5" %><% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
