<% content_for :title, "#{t("monitoring.channels.new.title")} · #{ApplicationHelper::CONFIG[:name]}" %>

<%= render layout: "monitoring/shell", locals: { current: :channels } do %>
  <%= render layout: "monitoring/page_bar", locals: { back: (@channel.kind ? new_monitoring_channel_path : monitoring_channels_path), title: t("monitoring.channels.new.title"), detail: (@channel.kind ? t("monitoring.channels.kinds.#{@channel.kind}") : t("monitoring.channels.new.description")) } do %>
    <% if @channel.kind %><%= render "monitoring/channels/submit", channel: @channel %><% end %>
  <% end %>
  <div class="min-h-0 flex-1 overflow-y-auto">
    <% if @channel.kind %>
      <%= render "monitoring/channels/form", channel: @channel %>
    <% else %>
      <%= render "monitoring/kind_picker", kinds: NotificationChannel.kinds.keys.map { |kind|
            available = kind != "email" || Shango::Mailing.enabled?
            { icon: channel_icon(kind), title: t("monitoring.channels.kinds.#{kind}"), hint: t(available ? "monitoring.channels.hints.#{kind}" : "monitoring.channels.new.mail_disabled"), path: (new_monitoring_channel_path(kind:) if available) }
          } %>
    <% end %>
  </div>
<% end %>
