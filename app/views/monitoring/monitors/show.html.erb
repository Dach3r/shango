<% content_for :title, "#{@monitor.name} · #{t("monitoring.title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% report = @report %>
<% heading = "border-b border-line px-5 pt-4 pb-2 font-mono text-xs uppercase tracking-wide text-faint" %>
<% label = "font-mono text-xs uppercase tracking-wide text-faint" %>

<div class="mx-auto flex max-w-6xl flex-col gap-6" data-controller="refresh">
  <%= link_to monitoring_root_path, class: "inline-flex w-fit items-center gap-1.5 text-sm text-muted transition hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
    <%= lucide_icon "arrow-left", class: "size-4" %><%= t("monitoring.show.back") %>
  <% end %>

  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="truncate text-lg font-semibold tracking-tight text-ink"><%= @monitor.name %></h1>
        <%= render MonitorStatus::Component.for(@monitor) %>
      </div>
      <p class="mt-1 font-mono text-sm break-all text-muted"><%= @monitor.http_method %> <%= @monitor.url %></p>
    </div>
    <% if policy(@monitor).update? %>
      <%= render "monitoring/monitors/actions", monitor: @monitor, compact: false %>
    <% end %>
  </header>

  <dl class="grid grid-cols-2 border border-line bg-card sm:grid-cols-4">
    <% { day: "uptime_day", week: "uptime_week", month: "uptime_month" }.each do |span, key| %>
      <div class="flex flex-col gap-1.5 border-r border-b border-line px-5 py-4 sm:border-b-0">
        <dt class="<%= label %>"><%= t("monitoring.show.#{key}") %></dt>
        <dd class="text-2xl leading-none font-medium text-ink"><%= monitor_uptime(report.uptime[span]) %></dd>
      </div>
    <% end %>
    <div class="flex flex-col gap-1.5 border-b border-line px-5 py-4 sm:border-b-0">
      <dt class="<%= label %>"><%= t("monitoring.show.average") %></dt>
      <dd class="text-2xl leading-none font-medium text-ink"><%= monitor_ms(report.average_ms) %></dd>
    </div>
  </dl>

  <section class="border border-line bg-card">
    <h2 class="<%= heading %>"><%= t("monitoring.chart.title") %></h2>
    <div class="px-5 py-4">
      <% if report.points.any?(&:last) %>
        <%= render ResponseChart::Component.new(points: report.points, label: t("monitoring.chart.label", name: @monitor.name)) %>
      <% else %>
        <p class="py-6 text-center text-sm text-muted"><%= t("monitoring.card.no_data") %></p>
      <% end %>
    </div>
  </section>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="border border-line bg-card">
      <h2 class="<%= heading %>"><%= t("monitoring.show.incidents") %></h2>
      <% if report.incidents.empty? %>
        <p class="px-5 py-4 text-sm text-muted"><%= t("monitoring.show.no_incidents") %></p>
      <% else %>
        <ul class="text-sm">
          <% report.incidents.each do |incident| %>
            <li class="flex flex-col gap-1 border-b border-line px-5 py-3 last:border-b-0">
              <div class="flex items-center justify-between gap-3">
                <span class="min-w-0 text-ink"><%= monitor_cause(incident.cause, incident.detail) %></span>
                <%= render MonitorStatus::Component.new(status: incident.open? ? :down : :up) %>
              </div>
              <span class="font-mono text-xs text-muted">
                <%= l(incident.started_at, format: :short) %> → <%= incident.open? ? t("monitoring.show.ongoing") : l(incident.resolved_at, format: :short) %>
                · <%= distance_of_time_in_words(incident.started_at, incident.resolved_at || Time.current) %>
                <% if incident.paused? %>· <%= t("monitoring.show.closed_by_pause") %><% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="border border-line bg-card">
      <h2 class="<%= heading %>"><%= t("monitoring.show.settings") %></h2>
      <dl class="text-sm">
        <% { interval: monitor_interval_label(@monitor.interval), timeout: t("monitoring.units.seconds", value: @monitor.timeout), confirmations: @monitor.confirmations,
             expected_statuses: @monitor.expected_statuses, max_response_ms: monitor_ms(@monitor.max_response_ms), environment: @monitor.environment&.name || "—",
             notification_channels: @monitor.notification_channels.map(&:name).sort.join(", ").presence || "—" }.each do |field, value| %>
          <div class="flex items-baseline justify-between gap-4 border-b border-line px-5 py-2.5 last:border-b-0">
            <dt class="text-muted"><%= UptimeMonitor.human_attribute_name(field) %></dt>
            <dd class="font-mono text-ink"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </section>
  </div>

  <section class="border border-line bg-card">
    <h2 class="<%= heading %>"><%= t("monitoring.show.checks") %></h2>
    <% if report.checks.empty? %>
      <p class="px-5 py-4 text-sm text-muted"><%= t("monitoring.show.no_checks") %></p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-line font-mono text-xs uppercase tracking-wide text-faint">
              <th scope="col" class="px-5 py-2 font-normal"><%= t("monitoring.show.columns.time") %></th>
              <th scope="col" class="px-5 py-2 font-normal"><%= t("monitoring.show.columns.status") %></th>
              <th scope="col" class="px-5 py-2 font-normal"><%= t("monitoring.show.columns.http_status") %></th>
              <th scope="col" class="px-5 py-2 text-right font-normal"><%= t("monitoring.show.columns.response") %></th>
              <th scope="col" class="px-5 py-2 font-normal"><%= t("monitoring.show.columns.cause") %></th>
            </tr>
          </thead>
          <tbody>
            <% report.checks.each do |check| %>
              <tr class="border-b border-line last:border-b-0">
                <td class="px-5 py-2 font-mono text-xs whitespace-nowrap text-muted"><%= l(check.checked_at, format: :short) %></td>
                <td class="px-5 py-2"><%= render MonitorStatus::Component.new(status: check.status) %></td>
                <td class="px-5 py-2 font-mono text-ink"><%= check.http_status || "—" %></td>
                <td class="px-5 py-2 text-right font-mono whitespace-nowrap text-ink"><%= monitor_ms(check.response_ms) %></td>
                <td class="px-5 py-2 text-muted"><%= check.error ? monitor_cause(check.error, check.detail) : "" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>
