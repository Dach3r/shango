<% content_for :title, "#{t("monitoring.title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% content_for :main_class, "flex min-h-0 flex-1" %>
<% summary = @overview[:summary] %>
<% label = "font-mono text-xs uppercase tracking-wide text-faint" %>
<% column = "font-mono text-[0.6875rem] font-normal uppercase tracking-wide text-faint" %>

<div class="flex min-w-0 flex-1 flex-col lg:h-[calc(100vh-2.5rem)]" data-controller="refresh">
  <h1 class="sr-only"><%= t("monitoring.title") %></h1>
  <header class="flex h-14 shrink-0 items-stretch justify-between gap-4 border-b border-line pl-2">
    <%= render "monitoring/tabs", current: :monitors, bar: true %>
    <% if policy(current_project.uptime_monitors.new).create? %>
      <%= link_to new_monitoring_monitor_path, class: button_classes(:primary, "shrink-0 px-5 sm:w-44") do %><%= lucide_icon "plus", class: "size-4" %><%= t("monitoring.index.new") %><% end %>
    <% end %>
  </header>

  <div class="flex min-h-0 flex-1 flex-col lg:flex-row">
    <aside class="flex shrink-0 flex-col border-b border-line lg:w-72 lg:overflow-y-auto lg:border-r lg:border-b-0">
      <dl class="grid grid-cols-2 border-b border-line">
        <div class="flex min-w-0 flex-col gap-2 border-r border-line px-5 py-4">
          <dt class="<%= label %>"><%= t("monitoring.index.in_use") %></dt>
          <dd class="text-2xl leading-none font-medium text-ink"><%= summary[:total] %> <span class="text-sm text-muted">/ <%= summary[:limit] %></span></dd>
        </div>
        <div class="flex min-w-0 flex-col gap-2 px-5 py-4">
          <dt class="<%= label %>"><%= t("monitoring.index.uptime") %></dt>
          <dd class="text-2xl leading-none font-medium text-ink"><%= monitor_uptime(summary[:uptime]) %></dd>
        </div>
      </dl>

      <nav aria-label="<%= t("monitoring.index.filter") %>" class="flex overflow-x-auto lg:flex-col lg:overflow-visible">
        <% [nil, *Monitoring::MonitorsController::FILTERS].each do |status| %>
          <%= link_to monitoring_root_path(status:, q: @query.presence), aria: { current: (@filter == status ? "page" : nil) },
                class: "flex shrink-0 items-center justify-between gap-4 border-r border-line px-5 py-3 text-sm text-muted transition hover:bg-card hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-accent/50 aria-[current=page]:bg-card aria-[current=page]:text-ink lg:border-r-0 lg:border-b lg:border-l-2 lg:border-l-transparent lg:aria-[current=page]:border-l-solid" do %>
            <span class="flex items-center gap-2.5">
              <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full <%= status ? class_names("bg-current", MonitorStatus::Component::TONES.fetch(status.to_sym)) : "bg-faint" %>"></span>
              <%= t("monitoring.index.filters.#{status || "all"}") %>
            </span>
            <span class="font-mono text-xs text-faint"><%= status ? summary[status.to_sym] : summary[:total] %></span>
          <% end %>
        <% end %>
      </nav>

      <section class="hidden p-5 lg:block">
        <h2 class="flex items-center gap-2 <%= label %>"><%= lucide_icon "info", class: "size-3.5" %><%= t("monitoring.index.about") %></h2>
        <p class="mt-3 text-sm leading-relaxed text-muted"><%= t("monitoring.index.description") %></p>
      </section>
    </aside>

    <section class="flex min-h-0 min-w-0 flex-1 flex-col">
      <%= form_with url: monitoring_root_path, method: :get, class: "relative flex h-14 shrink-0 items-stretch border-b border-line", role: "search" do |form| %>
        <%= form.hidden_field :status, value: @filter if @filter %>
        <%= form.label :q, t("monitoring.index.search"), class: "sr-only" %>
        <%= lucide_icon "search", class: "pointer-events-none absolute top-1/2 left-5 size-4 -translate-y-1/2 text-faint" %>
        <%= form.search_field :q, value: @query, placeholder: t("monitoring.index.search"), autocomplete: "off", class: bar_field_classes("h-full flex-1 border-0 pl-12") %>
      <% end %>

      <% if @monitors.empty? %>
        <div class="flex flex-1 flex-col items-center justify-center gap-3 px-6 py-16 text-center">
          <%= lucide_icon "activity", class: "size-8 text-faint" %>
          <p class="text-sm font-medium text-ink"><%= t(summary[:total].zero? ? "monitoring.index.empty.title" : "monitoring.index.empty.filtered") %></p>
          <% if summary[:total].zero? %>
            <p class="max-w-sm text-sm text-muted"><%= t("monitoring.index.empty.hint") %></p>
          <% end %>
        </div>
      <% else %>
        <div class="min-h-0 flex-1 overflow-y-auto">
          <div aria-hidden="true" class="sticky top-0 z-20 hidden h-9 items-center gap-x-6 border-b border-line bg-page px-5 lg:grid lg:grid-cols-[minmax(14rem,1.25fr)_minmax(9rem,1fr)_5rem_6rem_7.5rem_8rem]">
            <span class="<%= column %>"><%= UptimeMonitor.human_attribute_name(:name) %></span>
            <span class="<%= column %>"><%= t("monitoring.strip.title") %></span>
            <span class="<%= column %> text-right"><%= t("monitoring.card.uptime") %></span>
            <span class="<%= column %> text-right"><%= t("monitoring.card.average") %></span>
            <span class="<%= column %> text-right"><%= t("monitoring.card.checked") %></span>
            <span></span>
          </div>
          <ul>
            <% @monitors.each do |monitor| %>
              <%= render "monitoring/monitors/row", monitor:, card: @overview[:cards].fetch(monitor.id) %>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>
  </div>
</div>
