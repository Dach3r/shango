<% content_for :title, "#{t("monitoring.title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% summary = @overview[:summary] %>
<% cell = "flex min-w-0 flex-col gap-1.5 border-line px-5 py-4" %>
<% label = "font-mono text-xs uppercase tracking-wide text-faint" %>

<div class="mx-auto flex max-w-6xl flex-col gap-6" data-controller="refresh">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0">
      <h1 class="truncate text-lg font-semibold tracking-tight text-ink"><%= t("monitoring.title") %></h1>
      <p class="mt-1 text-sm text-muted"><%= t("monitoring.index.description") %></p>
    </div>
    <% if policy(current_project.uptime_monitors.new).create? %>
      <%= link_to new_monitoring_monitor_path, class: button_classes(:primary) do %><%= lucide_icon "plus", class: "size-4" %><%= t("monitoring.index.new") %><% end %>
    <% end %>
  </header>

  <dl class="grid grid-cols-2 border border-line bg-card sm:grid-cols-5">
    <div class="<%= cell %> border-r border-b sm:border-b-0">
      <dt class="<%= label %>"><%= t("monitoring.index.in_use") %></dt>
      <dd class="text-2xl leading-none font-medium text-ink"><%= summary[:total] %> <span class="text-sm text-muted">/ <%= summary[:limit] %></span></dd>
    </div>
    <% %i[up down paused].each do |status| %>
      <div class="<%= cell %> border-r border-b sm:border-b-0">
        <dt><%= render MonitorStatus::Component.new(status:) %></dt>
        <dd class="text-2xl leading-none font-medium text-ink"><%= summary[status] %></dd>
      </div>
    <% end %>
    <div class="<%= cell %> col-span-2 sm:col-span-1">
      <dt class="<%= label %>"><%= t("monitoring.index.uptime") %></dt>
      <dd class="text-2xl leading-none font-medium text-ink"><%= monitor_uptime(summary[:uptime]) %></dd>
    </div>
  </dl>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <nav aria-label="<%= t("monitoring.index.filter") %>" class="flex flex-wrap border border-line">
      <% [nil, *Monitoring::MonitorsController::FILTERS].each do |status| %>
        <%= link_to t("monitoring.index.filters.#{status || "all"}"), monitoring_root_path(status:, q: @query.presence), aria: { current: (@filter == status ? "page" : nil) },
              class: "-ml-px border-l border-line px-3 py-1.5 font-mono text-xs uppercase tracking-wide text-muted transition first:ml-0 first:border-l-0 hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50 aria-[current=page]:bg-solid aria-[current=page]:text-on-solid" %>
      <% end %>
    </nav>
    <%= form_with url: monitoring_root_path, method: :get, class: "flex w-full sm:w-72", role: "search" do |form| %>
      <%= form.hidden_field :status, value: @filter if @filter %>
      <%= form.label :q, t("monitoring.index.search"), class: "sr-only" %>
      <%= form.search_field :q, value: @query, placeholder: t("monitoring.index.search"), autocomplete: "off", class: field_classes %>
    <% end %>
  </div>

  <% if @monitors.empty? %>
    <div class="flex flex-col items-center justify-center gap-3 border border-line bg-card px-6 py-16 text-center">
      <%= lucide_icon "activity", class: "size-8 text-faint" %>
      <p class="text-sm font-medium text-ink"><%= t(summary[:total].zero? ? "monitoring.index.empty.title" : "monitoring.index.empty.filtered") %></p>
      <% if summary[:total].zero? %>
        <p class="max-w-sm text-sm text-muted"><%= t("monitoring.index.empty.hint") %></p>
      <% end %>
    </div>
  <% else %>
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <% @monitors.each do |monitor| %>
        <%= render "monitoring/monitors/card", monitor:, card: @overview[:cards].fetch(monitor.id) %>
      <% end %>
    </div>
  <% end %>
</div>
