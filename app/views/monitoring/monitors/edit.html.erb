<% content_for :title, "#{t("monitoring.edit.title")} · #{ApplicationHelper::CONFIG[:name]}" %>

<%= render layout: "monitoring/shell", locals: { current: :monitors } do %>
  <%= render layout: "monitoring/page_bar", locals: { back: monitoring_monitor_path(@monitor), title: t("monitoring.edit.title"), detail: @monitor.name_was } do %>
    <%= render "monitoring/monitors/submit", monitor: @monitor %>
  <% end %>
  <div class="min-h-0 flex-1 overflow-y-auto">
    <%= render "monitoring/monitors/form", monitor: @monitor %>
  </div>
<% end %>
