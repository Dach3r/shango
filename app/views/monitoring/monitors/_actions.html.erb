<%# Run, pause or resume, edit and delete one monitor; only rendered for members who may manage it. Render with `monitor:` and `compact:` (icon-only buttons in a row, named by their tooltip and label). %>
<div class="<%= compact ? "flex items-center" : "flex flex-wrap gap-2" %>">
  <% unless monitor.paused? || monitor.push? %>
    <%= button_to monitoring_monitor_run_path(monitor), form_class: "contents", **monitor_action(:run, compact:) do %><%= lucide_icon "play", class: "size-3.5" %><%= t("monitoring.actions.run") unless compact %><% end %>
  <% end %>
  <% if monitor.paused? %>
    <%= button_to monitoring_monitor_pause_path(monitor), method: :delete, form_class: "contents", **monitor_action(:resume, compact:) do %><%= lucide_icon "rotate-ccw", class: "size-3.5" %><%= t("monitoring.actions.resume") unless compact %><% end %>
  <% else %>
    <%= button_to monitoring_monitor_pause_path(monitor), form_class: "contents", **monitor_action(:pause, compact:) do %><%= lucide_icon "pause", class: "size-3.5" %><%= t("monitoring.actions.pause") unless compact %><% end %>
  <% end %>
  <%= link_to edit_monitoring_monitor_path(monitor), **monitor_action(:edit, compact:) do %><%= lucide_icon "pencil", class: "size-3.5" %><%= t("monitoring.actions.edit") unless compact %><% end %>
  <%= button_to monitoring_monitor_path(monitor), method: :delete, form_class: "contents", form: { data: { turbo_confirm: t("monitoring.actions.confirm_delete", name: monitor.name) } },
        **monitor_action(:delete, compact:, danger: true) do %><%= lucide_icon "trash-2", class: "size-3.5" %><%= t("monitoring.actions.delete") unless compact %><% end %>
</div>
