<%# One monitor in the list. Render with `monitor:` and `card:` (a Monitoring::Monitors::Overview::Card). %>
<% label = "font-mono text-[0.6875rem] uppercase tracking-wide text-faint" %>
<article class="flex min-w-0 flex-col border border-line bg-card">
  <header class="flex items-start justify-between gap-3 border-b border-line px-4 py-3">
    <div class="min-w-0">
      <h2 class="truncate text-sm font-semibold text-ink"><%= link_to monitor.name, monitoring_monitor_path(monitor), class: "hover:text-accent focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" %></h2>
      <p class="truncate font-mono text-xs text-faint" title="<%= monitor_target(monitor) %>"><%= monitor_target(monitor) %><% if monitor.expires_at %> · <%= monitor_expiry(monitor) %><% end %></p>
    </div>
    <%= render MonitorStatus::Component.for(monitor) %>
  </header>

  <div class="flex h-20 items-center px-4 py-3">
    <% if card.points.any?(&:last) %>
      <%= render ResponseChart::Component.new(points: card.points, label: t("monitoring.chart.label", name: monitor.name), compact: true) %>
    <% else %>
      <p class="w-full text-center text-xs text-faint"><%= t("monitoring.card.no_data") %></p>
    <% end %>
  </div>

  <dl class="grid grid-cols-3 border-t border-line">
    <div class="flex min-w-0 flex-col gap-1 border-r border-line px-4 py-2.5">
      <dt class="<%= label %>"><%= t("monitoring.card.uptime") %></dt>
      <dd class="font-mono text-sm text-ink"><%= monitor_uptime(card.uptime) %></dd>
    </div>
    <div class="flex min-w-0 flex-col gap-1 border-r border-line px-4 py-2.5">
      <dt class="<%= label %>"><%= t("monitoring.card.average") %></dt>
      <dd class="font-mono text-sm text-ink"><%= monitor_ms(card.average_ms) %></dd>
    </div>
    <div class="flex min-w-0 flex-col gap-1 px-4 py-2.5">
      <dt class="<%= label %>"><%= t("monitoring.card.checked") %></dt>
      <dd class="truncate font-mono text-sm text-ink"><%= monitor.last_checked_at ? t("monitoring.ago", time: time_ago_in_words(monitor.last_checked_at)) : "—" %></dd>
    </div>
  </dl>

  <% if policy(monitor).update? %>
    <%= render "monitoring/monitors/actions", monitor:, compact: true %>
  <% end %>
</article>
