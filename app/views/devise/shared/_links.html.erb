<div class="mt-6 space-y-2 text-center text-sm text-muted">
  <%- if controller_name != 'sessions' %>
    <p><%= t(".sign_in_prompt") %> <%= render Link::Component.new(label: t(".sign_in"), href: new_session_path(resource_name), class: "ml-1") %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p><%= t(".no_account") %> <%= render Link::Component.new(label: t(".sign_up"), href: new_registration_path(resource_name), class: "ml-1") %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= render Link::Component.new(label: t(".forgot_password"), href: new_password_path(resource_name)) %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= render Link::Component.new(label: t(".confirmation"), href: new_confirmation_path(resource_name)) %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= render Link::Component.new(label: t(".unlock"), href: new_unlock_path(resource_name)) %></p>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <p><%= button_to t(".omniauth", provider: OmniAuth::Utils.camelize(provider)), omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "cursor-pointer font-semibold text-accent hover:text-accent-hover" %></p>
    <% end %>
  <% end %>
</div>
