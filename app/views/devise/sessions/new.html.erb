<% content_for :title, "Iniciar sesión · #{ApplicationHelper::CONFIG[:name]}" %>

<main class="relative flex min-h-screen items-center justify-center overflow-hidden bg-gradient-to-br from-brand-50 via-white to-brand-50 px-4 py-10 font-sans text-neutral-900">
  <div class="pointer-events-none absolute -top-32 -left-32 size-96 rounded-full bg-brand-400/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-32 -bottom-32 size-96 rounded-full bg-brand-500/20 blur-3xl"></div>

  <div class="relative w-full max-w-md">
    <div class="rounded-3xl bg-white p-8 shadow-xl shadow-brand-700/10 ring-1 ring-neutral-200/70 sm:p-10">
      <div class="mb-8 text-center">
        <%= link_to unauthenticated_root_path, class: "mb-6 inline-flex items-center gap-2.5" do %>
          <span class="flex size-10 items-center justify-center rounded-xl bg-brand-500 text-xl font-bold text-white"><%= ApplicationHelper::CONFIG[:name].first %></span>
          <span class="text-2xl font-semibold tracking-tight"><%= ApplicationHelper::CONFIG[:name] %></span>
        <% end %>
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Bienvenido de vuelta</h1>
        <p class="mt-2 text-sm text-neutral-500">Ingresa tus datos para continuar</p>
      </div>

      <% if alert.present? %>
        <p role="alert" class="mb-6 rounded-xl bg-red-50 px-4 py-3 text-center text-sm text-red-700"><%= alert %></p>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render Input::Component.new(form: f, attribute: :email, label: "Correo", type: :email, placeholder: "tu@correo.com", autofocus: true, autocomplete: "email", required: true) %>
        <%= render Input::Component.new(form: f, attribute: :password, label: "Contraseña", type: :password, placeholder: "Tu contraseña", autocomplete: "current-password", required: true) %>

        <div class="flex items-center justify-between text-sm">
          <% if devise_mapping.rememberable? %>
            <label class="flex cursor-pointer items-center gap-2 text-neutral-700">
              <%= f.check_box :remember_me, class: "size-4 rounded border-neutral-300 accent-brand-500" %>
              Recordarme
            </label>
          <% end %>
          <% if devise_mapping.recoverable? %>
            <%= render Link::Component.new(label: "¿Olvidaste tu contraseña?", href: new_password_path(resource_name)) %>
          <% end %>
        </div>

        <%= render Button::Component.new(form: f, label: "Iniciar sesión") %>
      <% end %>

      <% if devise_mapping.registerable? %>
        <p class="mt-6 text-center text-sm text-neutral-600">
          ¿No tienes cuenta?
          <%= render Link::Component.new(label: "Regístrate", href: new_registration_path(resource_name), class: "ml-1") %>
        </p>
      <% end %>
    </div>
  </div>
</main>
