<% content_for :title, "#{t(".title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% content_for :heading do %><%= t(".heading_html") %><% end %>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
  <%= render Input::Component.new(form: f, attribute: :email, label: t(".email"), type: :email, placeholder: t(".email_placeholder"), autofocus: true, autocomplete: "email", required: true) %>
  <%= render Input::Component.new(form: f, attribute: :password, label: t(".password"), type: :password, placeholder: t(".password_placeholder"), autocomplete: "current-password", required: true) %>

  <div class="flex items-center justify-between pb-1 text-sm">
    <% if devise_mapping.rememberable? %>
      <%= render Checkbox::Component.new(form: f, attribute: :remember_me, label: t(".remember_me")) %>
    <% end %>
    <% if devise_mapping.recoverable? %>
      <%= render Link::Component.new(label: t(".forgot_password"), href: new_password_path(resource_name)) %>
    <% end %>
  </div>

  <%= render Button::Component.new(form: f, label: t(".submit")) %>
<% end %>

<% if devise_mapping.registerable? %>
  <div class="my-6 flex items-center gap-4 text-xs font-medium uppercase tracking-widest text-muted">
    <span class="h-px flex-1 bg-line"></span>
    <%= t(".or") %>
    <span class="h-px flex-1 bg-line"></span>
  </div>

  <%= render Button::Component.new(label: t(".sign_up"), href: new_registration_path(resource_name), variant: :secondary) %>
<% end %>
