<% content_for :title, "#{t(".title")} · #{ApplicationHelper::CONFIG[:name]}" %>

<%= render layout: "settings/shell", locals: { title: t(".title"), heading: t(".#{@tab}.heading"), description: t(".#{@tab}.description") } do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name, tab: @tab), html: { method: :put, class: "space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <% if @tab == "profile" %>
      <div class="grid gap-5 sm:grid-cols-2">
        <%= render Input::Component.new(form: f, attribute: :first_name, icon: "user", label: t("devise.registrations.new.first_name"), placeholder: t("devise.registrations.new.first_name_placeholder"), autocomplete: "given-name", required: true) %>
        <%= render Input::Component.new(form: f, attribute: :last_name, icon: "user", label: t("devise.registrations.new.last_name"), placeholder: t("devise.registrations.new.last_name_placeholder"), autocomplete: "family-name", required: true) %>
      </div>

      <%= render Input::Component.new(form: f, attribute: :email, label: t("devise.registrations.edit.email"), type: :email, placeholder: t("devise.registrations.edit.email_placeholder"), autocomplete: "email", required: true) %>
    <% else %>
      <%= render Input::Component.new(form: f, attribute: :password, label: t("devise.registrations.edit.new_password"), type: :password, placeholder: t("devise.registrations.edit.password_placeholder"), autocomplete: "new-password") %>
      <%= render Input::Component.new(form: f, attribute: :password_confirmation, label: t("devise.registrations.edit.confirm_password"), type: :password, placeholder: t("devise.registrations.edit.confirm_password_placeholder"), autocomplete: "new-password") %>
    <% end %>

    <div class="flex justify-end">
      <%= render Button::Component.new(form: f, label: t("devise.registrations.edit.submit")) %>
    </div>
  <% end %>

  <% if @tab == "security" %>
    <div class="mt-8 border-t border-line pt-6">
      <h2 class="text-sm font-medium text-ink"><%= t("devise.registrations.edit.cancel_heading") %></h2>
      <%= button_to t("devise.registrations.edit.cancel_account"), registration_path(resource_name), method: :delete, data: { turbo_confirm: t("devise.registrations.edit.confirm") },
                    class: "mt-3 cursor-pointer text-sm font-medium text-danger hover:text-danger/80" %>
    </div>
  <% end %>
<% end %>
