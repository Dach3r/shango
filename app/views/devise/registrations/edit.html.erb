<% content_for :title, "#{t(".title")} · #{ApplicationHelper::CONFIG[:name]}" %>

<%= render layout: "settings/shell", locals: { heading: t(".#{@tab}.heading"), description: t(".#{@tab}.description") } do %>
  <% if @tab == "preferences" %>
    <div class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-card">
      <% { locale: LocaleSwitcher::Component, zoom: ZoomPicker::Component }.each do |setting, switcher| %>
        <div class="grid gap-4 p-5 md:grid-cols-[1fr_17rem] md:items-center md:gap-8">
          <div class="min-w-0">
            <p class="text-sm font-semibold text-ink"><%= t("devise.registrations.edit.preferences.#{setting}.label") %></p>
            <p class="mt-1 text-xs leading-relaxed text-muted"><%= t("devise.registrations.edit.preferences.#{setting}.hint") %></p>
          </div>

          <div class="md:justify-self-end"><%= render switcher.new %></div>
        </div>
      <% end %>
    </div>
  <% elsif @tab != "delete_account" %>
    <% rows = if @tab == "profile"
         [
           [
             { attribute: :first_name, icon: "user", label: "devise.registrations.new.first_name", placeholder: "devise.registrations.new.first_name_placeholder", autocomplete: "given-name", required: true },
             { attribute: :last_name, icon: "user", label: "devise.registrations.new.last_name", placeholder: "devise.registrations.new.last_name_placeholder", autocomplete: "family-name", required: true }
           ],
           [
             { attribute: :email, type: :email, label: "devise.registrations.edit.email", placeholder: "devise.registrations.edit.email_placeholder", autocomplete: "email", required: true }
           ]
         ]
       else
         [
           [
             { attribute: :password, type: :password, label: "devise.registrations.edit.new_password", placeholder: "devise.registrations.edit.password_placeholder", autocomplete: "new-password" }
           ],
           [
             { attribute: :password_confirmation, type: :password, label: "devise.registrations.edit.confirm_password", placeholder: "devise.registrations.edit.confirm_password_placeholder", autocomplete: "new-password" }
           ]
         ]
       end %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name, tab: @tab), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-card">
        <% rows.each do |row| %>
          <div class="grid gap-4 p-5 <%= "md:grid-cols-2" if row.size > 1 %> md:gap-8">
            <% row.each do |field| %>
              <%= render Input::Component.new(form: f, **field.except(:label, :placeholder), label: t(field[:label]), placeholder: t(field[:placeholder])) %>
            <% end %>
          </div>
        <% end %>
      </div>

      <%= render "settings/save_button" %>
    <% end %>
  <% end %>

  <% if @tab == "delete_account" %>
    <div class="overflow-hidden rounded-2xl border border-line bg-card">
      <div class="grid gap-4 p-5 md:grid-cols-[1fr_20rem] md:items-center md:gap-8">
        <div class="min-w-0">
          <p class="text-sm font-semibold text-ink"><%= t("devise.registrations.edit.cancel_heading") %></p>
          <p class="mt-1 text-xs leading-relaxed text-muted"><%= t("devise.registrations.edit.fields.cancel_hint") %></p>
        </div>

        <div class="md:justify-self-end">
          <%= button_to registration_path(resource_name), method: :delete, data: { turbo_confirm: t("devise.registrations.edit.confirm") },
                        class: button_classes(:danger) do %>
            <%= lucide_icon "user-x", class: "size-4 shrink-0" %><%= t("devise.registrations.edit.cancel_account") %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
