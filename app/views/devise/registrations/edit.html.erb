<% content_for :title, "#{t(".title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% content_for :heading do %><%= t(".heading_html") %><% end %>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <%= render Input::Component.new(form: f, attribute: :email, label: t(".email"), type: :email, placeholder: t(".email_placeholder"), autocomplete: "email", required: true) %>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <p class="text-sm text-muted"><%= t(".awaiting_confirmation", email: resource.unconfirmed_email) %></p>
  <% end %>

  <%= render Input::Component.new(form: f, attribute: :password, label: t(".new_password"), type: :password, placeholder: t(".password_placeholder"), autocomplete: "new-password") %>
  <%= render Input::Component.new(form: f, attribute: :password_confirmation, label: t(".confirm_password"), type: :password, placeholder: t(".confirm_password_placeholder"), autocomplete: "new-password") %>

  <%= render Button::Component.new(form: f, label: t(".submit")) %>
<% end %>

<div class="mt-8 border-t border-line pt-6">
  <h2 class="text-sm font-medium text-ink"><%= t(".cancel_heading") %></h2>
  <%= button_to t(".cancel_account"), registration_path(resource_name), method: :delete, data: { turbo_confirm: t(".confirm") },
                class: "mt-3 cursor-pointer text-sm font-medium text-danger hover:text-danger/80" %>
</div>

<p class="mt-6 text-center text-sm">
  <%= render Link::Component.new(label: t(".back"), href: :back) %>
</p>
