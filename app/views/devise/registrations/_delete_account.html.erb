<% impact = Users::AccountImpact.new(resource) %>
<% eyebrow = "font-mono text-[0.6875rem] font-semibold uppercase tracking-widest" %>

<div class="mx-auto grid w-full max-w-3xl content-start gap-6 px-5 py-8 sm:px-7" data-controller="confirm-gate" data-confirm-gate-locked-value="<%= impact.blocked? %>">
  <div class="border border-danger/40">
    <div class="h-2 border-b border-danger/40 bg-[repeating-linear-gradient(135deg,transparent_0_0.5rem,color-mix(in_srgb,var(--color-danger)_28%,transparent)_0.5rem_0.625rem)]" aria-hidden="true"></div>
    <div class="flex items-start gap-3 px-5 py-4">
      <%= lucide_icon "triangle-alert", class: "mt-0.5 size-5 shrink-0 text-danger" %>
      <div>
        <p class="<%= eyebrow %> text-danger"><%= t("devise.registrations.edit.danger.eyebrow") %></p>
        <p class="mt-1 text-sm leading-relaxed text-ink"><%= t("devise.registrations.edit.danger.warning") %></p>
      </div>
    </div>
  </div>

  <% if impact.blocked? %>
    <section class="border border-danger bg-danger/5 px-5 py-4">
      <h2 class="<%= eyebrow %> flex items-center gap-2 text-danger"><%= lucide_icon "lock", class: "size-3.5" %><%= t("devise.registrations.edit.danger.blocked") %></h2>
      <p class="mt-2 text-sm leading-relaxed text-ink"><%= t("devise.registrations.edit.danger.blocked_body") %></p>
      <ul class="mt-3 flex flex-wrap gap-2">
        <% impact.blocked.each do |project| %>
          <li class="inline-flex items-center gap-2 border border-danger/40 px-2.5 py-1 text-xs font-medium text-ink"><%= lucide_icon project.icon, class: "size-3.5 text-danger" %><%= project.name %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="border border-line">
    <h2 class="<%= eyebrow %> border-b border-line px-5 py-3 text-muted"><span class="text-faint">01</span> · <%= t("devise.registrations.edit.danger.review") %></h2>

    <dl class="grid grid-cols-3 divide-x divide-line border-b border-line">
      <% [[:stat_projects, impact.doomed.size, true], [:stat_requests, impact.requests_count, true], [:stat_shared, impact.shared_count, false]].each do |key, value, loss| %>
        <div class="px-5 py-4">
          <dd class="<%= class_names("text-3xl font-semibold tabular-nums", "text-danger" => loss && value.positive?, "text-ink" => !(loss && value.positive?)) %>"><%= value %></dd>
          <dt class="mt-1 text-xs leading-snug text-muted"><%= t("devise.registrations.edit.danger.#{key}") %></dt>
        </div>
      <% end %>
    </dl>

    <% if impact.doomed.any? %>
      <ul class="divide-y divide-line">
        <% impact.doomed.each do |project| %>
          <li class="flex items-center gap-3 px-5 py-2.5 text-sm text-ink">
            <%= lucide_icon project.icon, class: "size-4 shrink-0 text-muted" %><span class="min-w-0 truncate"><%= project.name %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-5 py-3 text-xs text-muted"><%= t("devise.registrations.edit.danger.no_projects") %></p>
    <% end %>

    <p class="border-t border-line px-5 py-3 text-xs leading-relaxed text-muted"><%= t("devise.registrations.edit.danger.kept_body") %></p>
  </section>

  <%= form_with url: registration_path(resource_name), method: :delete, class: class_names("border border-line", "pointer-events-none opacity-50" => impact.blocked?), data: { turbo_confirm: t("devise.registrations.edit.confirm") } do %>
    <h2 class="<%= eyebrow %> border-b border-line px-5 py-3 text-muted"><span class="text-faint">02</span> · <%= t("devise.registrations.edit.danger.ack_title") %></h2>
    <div class="border-b border-line px-5 py-4">
      <%= render Checkbox::Component.new(name: :acknowledge, label: t("devise.registrations.edit.danger.ack"), label_class: "items-start text-sm leading-relaxed text-ink", data: { confirm_gate_target: "acknowledge", action: "change->confirm-gate#refresh" }) %>
    </div>

    <h2 class="<%= eyebrow %> border-b border-line px-5 py-3 text-muted"><span class="text-faint">03</span> · <%= t("devise.registrations.edit.danger.confirm_title") %></h2>
    <div class="grid gap-3 px-5 py-4 sm:grid-cols-[1fr_auto] sm:items-end">
      <div>
        <%= label_tag :current_password, t("devise.registrations.edit.current_password"), class: label_classes %>
        <%= password_field_tag :current_password, nil, autocomplete: "current-password", required: true, placeholder: t("devise.registrations.edit.current_password_placeholder"), class: field_classes, data: { confirm_gate_target: "password", action: "input->confirm-gate#refresh" } %>
      </div>
      <%= button_tag type: :submit, disabled: true, class: button_classes(:danger_solid, "sm:py-2.5"), data: { confirm_gate_target: "submit" } do %>
        <%= lucide_icon "user-x", class: "size-4 shrink-0" %><%= t("devise.registrations.edit.cancel_account") %>
      <% end %>
    </div>
  <% end %>

  <% if impact.blocked? %>
    <p class="text-xs leading-relaxed text-danger"><%= t("devise.registrations.edit.danger.blocked_hint") %></p>
  <% end %>
</div>
