<%# Sidebar tree + content area shared by every API Client screen. Render with a block. %>
<% content_for :main_class, "flex min-h-0 flex-1" %>

<div class="flex h-[calc(100vh-2.5rem)] w-full flex-col md:flex-row">
  <aside class="max-h-60 shrink-0 overflow-hidden border-b border-line bg-card md:max-h-none md:w-72 md:border-r md:border-b-0">
    <%= render RequestTree::Component.new(branches: workspace_tree, current_request_id: @api_request&.id) %>
  </aside>

  <%= tag.section class: "flex min-h-0 min-w-0 flex-1 flex-col", data: local_assigns[:section_data] do %>
    <%= render RequestTabs::Component.new(requests: open_requests, current_request_id: @api_request&.id) do %><%= yield :request_actions if content_for?(:request_actions) %><% end %>
    <%= yield %>
  <% end %>
</div>
