<%= render Modal::Component.new(icon: "download", title: t(".title"), description: t(".description", collection: @collection.name), size: :lg, form: "export_form", submit: t(".submit"), submit_icon: "download") do %>
  <%= form_with url: workbench_collection_exports_path(@collection), method: :post, id: "export_form", data: { turbo_frame: "modal" }, class: "space-y-5" do %>
    <% if @error.present? %>
      <div role="alert" class="border border-danger/40 bg-danger/10 px-4 py-3 text-sm text-danger"><%= @error %></div>
    <% end %>
    <fieldset>
      <legend class="<%= label_classes %>"><%= t(".format") %></legend>
      <div class="mt-1 grid gap-2">
        <% ApiClient::Exports::Export::FORMATS.each_with_index do |format, index| %>
          <label class="flex cursor-pointer items-start gap-3 border border-line px-3 py-2.5 transition hover:bg-field has-[:checked]:border-accent has-[:checked]:bg-accent/10">
            <%= radio_button_tag :format_name, format, index.zero?, class: "mt-0.5 accent-accent" %>
            <span class="min-w-0">
              <span class="block text-sm font-medium text-ink"><%= t(".formats.#{format}.name") %></span>
              <span class="block text-xs text-muted"><%= t(".formats.#{format}.hint") %></span>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="space-y-3">
      <legend class="<%= label_classes %>"><%= t(".include") %></legend>
      <% { include_environments: "environments", include_credentials: "credentials" }.each do |name, key| %>
        <%= render Checkbox::Component.new(name: name, label_class: "!items-start", label: safe_join([
          tag.span(t(".#{key}"), class: "block text-sm text-ink"),
          tag.span(t(".#{key}_hint"), class: "block text-xs text-muted")
        ])) %>
      <% end %>
    </fieldset>
  <% end %>
<% end %>
