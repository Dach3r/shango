<%= turbo_frame_tag "modal" do %>
  <%= render Modal::Component.new(icon: "file-pen-line", title: t(".title"), description: t(".description", name: @api_request.name), size: :sm, centered: true) do |modal| %>
    <% modal.with_footer do %>
      <%= link_to t(".save"), new_workbench_request_placement_path(@api_request), class: button_classes(:primary, "w-full") %>
      <div class="flex w-full gap-2">
        <button type="button" data-action="dialog#close" class="<%= button_classes(:ghost, "flex-1") %>"><%= t(".cancel") %></button>
        <%= button_to t(".discard"), workbench_request_path(@api_request), method: :delete, class: button_classes(:danger, "w-full"), form_class: "flex-1", data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
  <% end %>
<% end %>
