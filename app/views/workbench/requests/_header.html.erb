<%# Request title and actions. Lives outside the editor form; the name input joins it through its `form` attribute. %>
<div class="flex flex-wrap items-center gap-3 border-b border-line px-4 py-2">
  <div class="flex min-w-0 flex-1 items-center gap-2 text-sm text-muted">
    <span class="shrink-0 truncate"><%= api_request.collection.name %></span>
    <% if api_request.folder %>
      <% api_request.folder.ancestors.reverse.each do |folder| %>
        <%= lucide_icon "chevron-right", class: "size-3 shrink-0" %><span class="shrink-0 truncate"><%= folder.name %></span>
      <% end %>
      <%= lucide_icon "chevron-right", class: "size-3 shrink-0" %><span class="shrink-0 truncate"><%= api_request.folder.name %></span>
    <% end %>
    <%= lucide_icon "chevron-right", class: "size-3 shrink-0" %>
    <input type="text" name="api_request[name]" form="request_form" value="<%= api_request.name %>" aria-label="<%= t("workbench.requests.name") %>" autocomplete="off"
           class="min-w-0 flex-1 rounded-md border border-transparent bg-transparent px-2 py-1 text-sm font-medium text-ink transition hover:border-line focus:border-solid focus:bg-field-focus focus:outline-none">
  </div>

  <div class="flex items-center gap-2">
    <button type="button" data-action="request-form#copyCurl" data-copied-label="<%= t("workbench.requests.copied") %>" class="<%= button_classes(:ghost) %>">
      <%= lucide_icon "terminal", class: "size-4" %><span data-label><%= t("workbench.requests.copy_curl") %></span>
    </button>
    <%= button_to workbench_request_duplication_path(api_request), method: :post, class: button_classes(:ghost), form_class: "contents" do %>
      <%= lucide_icon "copy", class: "size-4" %><%= t("workbench.requests.duplicate") %>
    <% end %>
    <%= button_to workbench_request_path(api_request), method: :delete, class: button_classes(:ghost, "hover:!text-danger"), form_class: "contents",
                  form: { data: { turbo_confirm: t("workbench.requests.confirm_delete", name: api_request.name) } } do %>
      <%= lucide_icon "trash-2", class: "size-4" %><%= t("workbench.requests.delete") %>
    <% end %>
  </div>
</div>
