<div class="flex h-full flex-col">
  <p data-body-type-target="panel" data-types="none" class="p-4 text-sm text-muted"><%= t("workbench.body.none_hint") %></p>

  <div data-body-type-target="panel" data-types="json text xml graphql" class="min-h-0 flex-1" hidden>
    <div class="h-full bg-field p-1">
      <%= render CodeEditor::Component.new(name: "api_request[body]", value: api_request.body, language: (api_request.body_type == "json" ? "json" : (api_request.body_type == "xml" ? "xml" : "text")),
                                           variables: editor_variables, variables_url: editor_variables_url, responses: editor_responses, responses_url: editor_responses_url, placeholder: t("workbench.body.placeholder"), class: "h-full",
                                           data: { action: "body-type:language@window->code-editor#changeLanguage" }) %>
    </div>
  </div>

  <div data-body-type-target="panel" data-types="graphql" class="shrink-0 border-t border-line p-4 pt-3" hidden>
    <label class="<%= label_classes %>"><%= t("workbench.body.graphql_variables") %></label>
    <div class="h-32 bg-field p-1">
      <%= render CodeEditor::Component.new(name: "api_request[graphql_variables]", value: api_request.graphql_variables, language: "json", variables: editor_variables, variables_url: editor_variables_url, responses: editor_responses, responses_url: editor_responses_url, class: "h-full", placeholder: "{}") %>
    </div>
  </div>

  <div data-body-type-target="panel" data-types="form_urlencoded multipart" class="[&>div>div:first-child]:border-x-0 [&>div>div:first-child]:border-t-0" hidden>
    <%= render KeyValueTable::Component.new(name: "api_request[body_form]", rows: api_request.body_form, variant: :form_data, files: !api_request.draft?) %>
    <% if api_request.draft? %>
      <p class="px-4 pb-3 text-xs text-muted"><%= t("workbench.body.save_first") %></p>
    <% end %>
  </div>

  <div data-body-type-target="panel" data-types="binary" class="p-4" hidden>
    <label for="api_request_binary_upload" class="<%= label_classes %>"><%= t("workbench.body.binary") %></label>
    <% if api_request.draft? %>
      <p class="text-sm text-muted"><%= t("workbench.body.save_first") %></p>
    <% else %>
    <%= file_field_tag "api_request[binary_upload]", id: "api_request_binary_upload",
                       class: field_classes("max-w-md text-xs file:mr-3 file:border-0 file:bg-accent/10 file:px-2 file:py-1 file:text-xs file:font-medium file:text-accent") %>
    <% if api_request.binary_body.attached? %>
      <p class="mt-2 text-xs text-muted"><%= t("workbench.body.current_file", name: api_request.binary_body.filename) %></p>
    <% end %>
    <% end %>
  </div>
</div>
