<% content_for :title, "#{@api_request.name} · #{ApplicationHelper::CONFIG[:name]}" %>
<% content_for :heading, t("workbench.title") %>

<% content_for :request_actions, render("workbench/requests/actions", api_request: @api_request) %>
<% content_for :breadcrumb, render("workbench/requests/breadcrumb", api_request: @api_request) %>

<%= render layout: "workbench/workspace", locals: { section_data: {
  controller: "request-form",
  request_form_run_url_value: workbench_request_executions_path(@api_request),
  request_form_curl_url_value: workbench_request_curl_export_path(@api_request),
  action: "keydown.ctrl+enter@window->request-form#run keydown.meta+enter@window->request-form#run keydown.ctrl+s@window->request-form#save keydown.meta+s@window->request-form#save"
} } do %>
  <div class="flex min-h-0 flex-1 flex-col" data-controller="resizable">
    <div class="flex min-h-0 flex-1 flex-col overflow-hidden">
      <template data-request-form-target="failure">
        <div role="alert" class="m-4 rounded-xl border border-danger/40 bg-danger/10 p-4 text-sm text-danger"><%= t("workbench.executions.failure") %></div>
      </template>
      <%= render "workbench/requests/editor", api_request: @api_request %>
    </div>

    <div class="relative h-1/2 shrink-0 border-t border-line bg-card" data-resizable-target="panel">
      <div role="separator" aria-orientation="horizontal" tabindex="0" aria-label="<%= t("workbench.executions.resize") %>"
           data-action="pointerdown->resizable#start dblclick->resizable#reset keydown->resizable#key"
           class="group absolute inset-x-0 -top-1 z-10 h-2 cursor-row-resize touch-none transition hover:bg-accent/40 focus-visible:bg-accent/40 focus-visible:outline-none">
        <%= lucide_icon "ellipsis", class: "pointer-events-none absolute left-1/2 top-1/2 size-4 -translate-x-1/2 -translate-y-1/2 text-fg-muted opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100" %>
      </div>
      <%= turbo_frame_tag "response_panel", class: "block h-full" do %>
        <%= render "workbench/requests/executions/response", execution: @execution, api_request: @api_request %>
      <% end %>
    </div>
  </div>
  <%= render Oauth2Forms::Component.new(owner: @api_request) %>
<% end %>
