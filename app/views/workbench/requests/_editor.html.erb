<%# The request editor form: URL bar plus Params / Authorization / Headers / Body / Settings tabs. %>
<% tabs = [
  { name: "params", label: t("workbench.tabs.params"), count: param_rows(api_request).count { |row| row["enabled"] } },
  { name: "authorization", label: t("workbench.tabs.authorization"), dot: !api_request.inherits_auth? && api_request.auth_type != "none" },
  { name: "headers", label: t("workbench.tabs.headers"), count: api_request.headers.count { |row| row["enabled"] } },
  { name: "body", label: t("workbench.tabs.body"), dot: api_request.body_type != "none" },
  { name: "settings", label: t("workbench.tabs.settings") }
] %>

<%= form_with model: api_request, scope: :api_request, url: workbench_request_path(api_request), method: :patch, id: "request_form", multipart: true,
              class: "flex min-h-0 flex-1 flex-col", data: variable_autocomplete_data(controller: "request-url request-draft url-preview").merge(request_form_target: "form", request_draft_url_value: workbench_request_draft_path(api_request), request_draft_saving_value: t("workbench.requests.draft_saving"), request_draft_saved_value: t("workbench.requests.draft_saved"), request_draft_error_value: t("workbench.requests.draft_error"), url_preview_variables_value: editor_variables.to_json,
                                                                                                    action: "input->request-draft#schedule input->url-preview#update change->request-draft#schedule change->url-preview#update url-preview:refresh->url-preview#update variable:saved@window->url-preview#variableSaved variable:created@window->url-preview#variableCreated key-value-table:change->request-draft#schedule request-form:run->request-draft#stop submit->request-draft#stop turbo:before-visit@document->request-draft#leave pagehide@window->request-draft#leave") do |form| %>
  <%= render ResponseReferenceModal::Component.new(responses: editor_responses) %>
  <%= hidden_field_tag "place", 1, id: nil if api_request.draft? %>
  <% if api_request.errors.any? %>
    <div role="alert" class="mx-4 mt-3 border border-danger/40 bg-danger/10 px-4 py-3 text-sm text-danger">
      <%= api_request.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <% unless policy(api_request).update? %>
    <div role="status" class="mx-4 mt-3 border border-line bg-ink/[0.05] px-4 py-2 text-xs text-muted"><%= t("team.read_only.request") %></div>
  <% end %>

  <% if @unsaved %>
    <div role="status" class="mx-4 mt-3 flex items-center justify-between gap-3 border border-line bg-ink/[0.05] px-4 py-2 text-xs text-muted">
      <span><%= t("workbench.requests.unsaved_notice") %></span>
      <%= link_to t("workbench.requests.discard_changes"), workbench_request_draft_path(api_request), data: { turbo_method: :delete }, class: "cursor-pointer text-ink underline-offset-2 hover:underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" %>
    </div>
  <% end %>

  <div class="@container flex items-stretch border-b border-line bg-ink/[0.05] transition focus-within:bg-ink/[0.08]" data-resizable-target="bounds">
    <div class="flex">
      <%= render Select::Component.new(name: "api_request[http_method]", options: method_options, value: api_request.http_method, label: t("workbench.requests.method"),
                                       class: "w-24 @xl:w-28 shrink-0 h-full border-0! bg-transparent! justify-center! gap-3! px-4! font-mono text-xs font-semibold focus:ring-0! [&>[data-select-target=label]]:flex-none",
                                       input_data: { action: "change->request-form#methodChanged" }) %>
    </div>
    <span class="w-px shrink-0 bg-line" aria-hidden="true"></span>
    <div class="min-w-0 flex-1 px-3 py-4">
      <%= render CodeEditor::Component.new(name: "api_request[url]", value: api_request.url, single_line: true, placeholder: t("workbench.requests.url_placeholder"), variables: editor_variables, variables_url: editor_variables_url, responses: editor_responses, responses_url: editor_responses_url,
                                           input_data: { request_url_target: "url", action: "input->request-url#urlChanged" }) %>
    </div>
    <button type="button" data-request-form-target="send" data-action="request-form#toggle" title="<%= t("workbench.requests.send_hint") %>"
            class="<%= button_classes(:primary, "group border-l border-line px-4 @xl:min-w-28 data-[busy=true]:bg-danger data-[busy=true]:text-white data-[busy=true]:hover:bg-danger/90 data-[busy=true]:focus-visible:ring-danger/50") %>">
      <span class="contents group-data-[busy=true]:hidden">
        <%= lucide_icon "send", class: "size-4" %>
        <span class="hidden @xl:inline"><%= t("workbench.requests.send") %></span>
        <span class="sr-only @xl:hidden"><%= t("workbench.requests.send") %></span>
      </span>
      <span class="hidden items-center gap-2 group-data-[busy=true]:flex" title="<%= t("workbench.requests.cancel_hint") %>">
        <%= lucide_icon "circle-x", class: "size-4" %>
        <span class="hidden @xl:inline"><%= t("workbench.requests.cancel") %></span>
        <span class="sr-only @xl:hidden"><%= t("workbench.requests.cancel") %></span>
      </span>
    </button>
  </div>

  <div class="group/editor relative flex min-h-0 flex-1 flex-col" data-controller="tabs body-type" data-tabs-active-value="params" data-tabs-key-value="request-editor">
    <%= render TabBar::Component.new(items: tabs, label: t("workbench.tabs.label")) do %>
      <div data-tabs-target="panel" data-name="body" class="w-56 shrink-0" hidden>
        <%= render Select::Component.new(name: "api_request[body_type]", options: body_type_options, value: api_request.body_type, id: "api_request_body_type", label: t("workbench.body.type"), class: "border-y-0 border-r-0 focus:border-line! focus:ring-0! focus:bg-field! aria-expanded:bg-ink/[0.08]!", dock: true, searchable: false,
                                         input_data: { body_type_target: "select", action: "change->body-type#change" }) %>
      </div>
    <% end %>

    <div class="min-h-0 flex-1 overflow-y-auto group-has-[[data-dock]:not([hidden])]/editor:pr-56">
      <div data-tabs-target="panel" data-name="params" class="[&>div>div:first-child]:border-x-0 [&>div>div:first-child]:border-t-0">
        <%= render KeyValueTable::Component.new(name: "api_request[query_params]", rows: param_rows(api_request), key_placeholder: t("workbench.params.key"), add_label: t("workbench.params.add"),
                                                data: { request_url_target: "params", action: "key-value-table:change->request-url#paramsChanged" }) %>
      </div>

      <div data-tabs-target="panel" data-name="authorization" class="p-4" hidden>
        <%= render AuthFields::Component.new(scope: "api_request", record: api_request, inheritable: true) %>
      </div>

      <div data-tabs-target="panel" data-name="headers" class="[&>div>div:first-child]:border-x-0 [&>div>div:first-child]:border-t-0" hidden>
        <%= render KeyValueTable::Component.new(name: "api_request[headers]", rows: api_request.headers, key_placeholder: t("workbench.headers.key"), add_label: t("workbench.headers.add")) %>
      </div>

      <div data-tabs-target="panel" data-name="body" class="h-full" hidden>
        <%= render "workbench/requests/body", api_request: api_request %>
      </div>

      <div data-tabs-target="panel" data-name="settings" hidden>
        <%= render "workbench/requests/settings", api_request: api_request %>
      </div>
    </div>
  </div>
<% end %>
