<%# The request editor form: URL bar plus Params / Authorization / Headers / Body / Settings tabs. %>
<% tabs = [
  { name: "params", label: t("workbench.tabs.params"), count: param_rows(api_request).count { |row| row["enabled"] } },
  { name: "authorization", label: t("workbench.tabs.authorization"), dot: !api_request.inherits_auth? && api_request.auth_type != "none" },
  { name: "headers", label: t("workbench.tabs.headers"), count: api_request.headers.count { |row| row["enabled"] } },
  { name: "body", label: t("workbench.tabs.body"), dot: api_request.body_type != "none" },
  { name: "settings", label: t("workbench.tabs.settings") }
] %>

<%= form_with model: api_request, scope: :api_request, url: workbench_request_path(api_request), method: :patch, id: "request_form", multipart: true,
              class: "flex min-h-0 flex-1 flex-col", data: { request_form_target: "form", controller: "request-url" } do |form| %>
  <%= hidden_field_tag "place", 1, id: nil if api_request.draft? %>
  <% if api_request.errors.any? %>
    <div role="alert" class="mx-4 mt-3 rounded-xl border border-danger/40 bg-danger/10 px-4 py-3 text-sm text-danger">
      <%= api_request.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="flex items-start gap-2 p-3" data-resizable-target="bounds">
    <div class="flex min-w-0 flex-1 items-stretch rounded-lg border border-line bg-field pr-3 transition focus-within:border-solid focus-within:ring-2 focus-within:ring-solid/40">
      <div class="flex">
        <%= render Select::Component.new(name: "api_request[http_method]", options: method_options, value: api_request.http_method, label: t("workbench.requests.method"),
                                         class: "w-24 shrink-0 h-full rounded-none! rounded-l-[7px]! border-0! bg-card! px-3! font-mono text-xs font-semibold focus:ring-0! focus:bg-card!",
                                         input_data: { action: "change->request-form#methodChanged" }) %>
      </div>
      <span class="w-px shrink-0 bg-line" aria-hidden="true"></span>
      <div class="min-w-0 flex-1 py-2 pl-3">
        <%= render CodeEditor::Component.new(name: "api_request[url]", value: api_request.url, single_line: true, placeholder: t("workbench.requests.url_placeholder"), variables: editor_variables,
                                             input_data: { request_url_target: "url", action: "input->request-url#urlChanged" }) %>
      </div>
    </div>
    <button type="button" data-request-form-target="send" data-action="request-form#run" title="<%= t("workbench.requests.send_hint") %>"
            class="<%= button_classes(:primary, "group min-w-24 data-[busy=true]:opacity-70") %>">
      <%= lucide_icon "send", class: "size-4 group-data-[busy=true]:hidden" %>
      <%= lucide_icon "loader-circle", class: "hidden size-4 animate-spin group-data-[busy=true]:block" %>
      <%= t("workbench.requests.send") %>
    </button>
    <%= form.submit t("workbench.requests.save"), id: nil, class: button_classes(:secondary) %>
  </div>

  <div class="flex min-h-0 flex-1 flex-col" data-controller="tabs" data-tabs-active-value="params" data-tabs-key-value="request-editor">
    <%= render TabBar::Component.new(items: tabs, label: t("workbench.tabs.label")) %>

    <div class="min-h-0 flex-1 overflow-y-auto p-4">
      <div data-tabs-target="panel" data-name="params">
        <p class="mb-3 flex items-center gap-2 text-xs text-muted"><%= lucide_icon "info", class: "size-3.5 shrink-0" %><%= t("workbench.params.hint") %></p>
        <%= render KeyValueTable::Component.new(name: "api_request[query_params]", rows: param_rows(api_request), key_placeholder: t("workbench.params.key"), add_label: t("workbench.params.add"),
                                                data: { request_url_target: "params", action: "key-value-table:change->request-url#paramsChanged" }) %>
      </div>

      <div data-tabs-target="panel" data-name="authorization" hidden>
        <%= render AuthFields::Component.new(scope: "api_request", record: api_request, inheritable: true) %>
      </div>

      <div data-tabs-target="panel" data-name="headers" hidden>
        <p class="mb-3 flex items-center gap-2 text-xs text-muted"><%= lucide_icon "info", class: "size-3.5 shrink-0" %><%= t("workbench.headers.hint") %></p>
        <%= render KeyValueTable::Component.new(name: "api_request[headers]", rows: api_request.headers, key_placeholder: t("workbench.headers.key"), add_label: t("workbench.headers.add")) %>
      </div>

      <div data-tabs-target="panel" data-name="body" hidden>
        <%= render "workbench/requests/body", api_request: api_request %>
      </div>

      <div data-tabs-target="panel" data-name="settings" hidden>
        <%= render "workbench/requests/settings", api_request: api_request %>
      </div>
    </div>
  </div>
<% end %>
