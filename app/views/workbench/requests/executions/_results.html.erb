<%# The outcomes (assertions, extractors) of one run, as a list. %>
<ul class="divide-y divide-line">
  <% results.each do |outcome| %>
    <li class="flex items-start gap-3 px-4 py-2.5 text-xs">
      <%= lucide_icon outcome_icon(outcome), class: "mt-0.5 size-4 shrink-0 #{outcome_tone(outcome)}", "aria-hidden": true %>
      <div class="min-w-0">
        <p class="font-mono break-all text-ink"><%= outcome_title(outcome) %></p>
        <% if (detail = outcome_detail(outcome)) %>
          <p class="mt-0.5 break-all text-muted"><%= detail %></p>
        <% end %>
      </div>
      <span class="sr-only"><%= t("workbench.executions.tests.statuses.#{outcome["status"]}") %></span>
    </li>
  <% end %>
</ul>
