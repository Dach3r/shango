<%# Response panel. `execution` may be nil (nothing sent yet). Rendered inside the "response_panel" frame. %>
<% if execution.nil? %>
  <div class="flex h-full min-h-0 flex-col">
  <div class="flex min-h-0 flex-1 flex-col items-center justify-center gap-2 p-6 text-center">
    <%= lucide_icon "send", class: "size-8 text-faint" %>
    <p class="text-sm font-medium text-ink"><%= t("workbench.executions.empty_title") %></p>
    <p class="text-xs text-muted"><%= t("workbench.executions.empty_hint") %></p>
  </div>
  <% saved = api_request.request_executions.recent.limit(RequestExecution::KEEP_PER_REQUEST).select(:id, :status, :status_text, :error_kind, :duration_ms, :created_at, :http_method) %>
  <% if saved.any? %>
    <div class="border-t border-line p-2">
      <h3 class="px-3 py-2 text-xs font-semibold tracking-wide text-muted uppercase"><%= t("workbench.executions.tabs.history") %></h3>
      <%= render "workbench/requests/executions/history", api_request:, history: saved, current_id: nil %>
    </div>
  <% end %>
  </div>
<% else %>
  <% history = api_request.request_executions.recent.limit(RequestExecution::KEEP_PER_REQUEST).select(:id, :status, :status_text, :error_kind, :duration_ms, :created_at, :http_method) %>
  <% timing = timing_rows(execution) unless execution.error? %>
  <% cookies = response_cookies(execution) %>
  <% searchable = !execution.error? && !execution.body_omitted && execution.response_body.present? %>
  <% tabs = [
    { name: "body", label: t("workbench.executions.tabs.body") },
    { name: "headers", label: t("workbench.executions.tabs.headers"), count: execution.response_headers.size },
    ({ name: "tests", label: t("workbench.executions.tabs.tests"), count: execution.test_results.size, dot: execution.failed_tests.positive? } if execution.test_results.any?),
    ({ name: "console", label: t("workbench.executions.tabs.console"), count: execution.script_logs.size } if execution.script_logs.any?),
    ({ name: "cookies", label: t("workbench.executions.tabs.cookies"), count: cookies.size } if cookies.any?),
    ({ name: "timing", label: t("workbench.executions.tabs.timing") } if timing.present?),
    { name: "request", label: t("workbench.executions.tabs.request"), dot: execution.unresolved_variables.any? },
    { name: "payload", label: t("workbench.executions.tabs.payload") },
    { name: "history", label: t("workbench.executions.tabs.history"), count: history.size }
  ].compact %>

  <div class="flex h-full min-h-0 flex-col" data-controller="tabs" data-tabs-active-value="body" data-tabs-key-value="response">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-line px-4 py-3 text-xs text-muted">
      <%= render StatusBadge::Component.new(execution:) %>
      <div class="flex items-center divide-x divide-line border border-line bg-field/40">
        <%= render "workbench/requests/executions/timing", execution: %>
        <% unless execution.error? %>
          <span class="flex items-center gap-1.5 px-2.5 py-1 tabular-nums" title="<%= t("workbench.executions.size") %>">
            <%= lucide_icon "hard-drive", class: "size-3.5 text-faint" %><%= format_size(execution.size_bytes) %>
          </span>
        <% end %>
        <% if execution.redirects.any? %>
          <span class="flex items-center gap-1.5 px-2.5 py-1">
            <%= lucide_icon "corner-up-right", class: "size-3.5 text-faint" %><%= t("workbench.executions.redirects", count: execution.redirects.size) %>
          </span>
        <% end %>
      </div>
      <time class="ml-auto flex items-center gap-1.5 tabular-nums" datetime="<%= execution.created_at.iso8601 %>">
        <%= lucide_icon "calendar-clock", class: "size-3.5 text-faint" %><%= l(execution.created_at, format: :short) %>
      </time>
      <% if execution.new_record? && !execution.error? && api_request.persisted? %>
        <%= button_to workbench_request_execution_saves_path(api_request, execution.id),
                      class: "flex cursor-pointer items-center gap-1.5 border border-line px-2.5 py-1 font-medium text-ink transition hover:bg-field focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
          <%= lucide_icon "save", class: "size-3.5" %><%= t("workbench.executions.save") %>
        <% end %>
      <% end %>
    </div>

    <%= render TabBar::Component.new(items: tabs, label: t("workbench.executions.tabs.label")) do %>
      <% if searchable %>
        <div data-tabs-target="panel" data-name="body" data-controller="response-search" data-empty="true" class="group/search flex h-full items-center gap-1 pl-2 pr-4">
          <label class="flex items-center gap-1.5 border border-line bg-field/40 px-2 py-1 text-xs text-muted focus-within:border-accent/60">
            <%= lucide_icon "search", class: "size-3.5 shrink-0 text-faint" %>
            <input type="search" data-response-search-target="input" data-action="input->response-search#input keydown->response-search#keydown" placeholder="<%= t("workbench.executions.search.placeholder") %>" aria-label="<%= t("workbench.executions.search.label") %>" autocomplete="off" spellcheck="false"
                   class="w-40 min-w-0 bg-transparent text-ink placeholder:text-faint focus:outline-none [&::-webkit-search-cancel-button]:hidden">
            <span data-response-search-target="count" class="min-w-6 text-right font-mono tabular-nums text-faint empty:hidden"></span>
          </label>
          <div class="flex group-data-[empty=true]/search:hidden">
            <% { previous: "chevron-up", next: "chevron-down" }.each do |action, icon| %>
              <button type="button" data-action="response-search#<%= action %>" title="<%= t("workbench.executions.search.#{action}") %>" aria-label="<%= t("workbench.executions.search.#{action}") %>"
                      class="flex size-6 cursor-pointer items-center justify-center text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50"><%= lucide_icon icon, class: "size-3.5" %></button>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <div class="min-h-0 flex-1 overflow-y-auto">
      <div data-tabs-target="panel" data-name="body" class="h-full">
        <%= render "workbench/requests/executions/body", execution: %>
      </div>

      <div data-tabs-target="panel" data-name="headers" hidden>
        <%= render "workbench/requests/executions/headers", headers: execution.response_headers, bleed: true, empty: t("workbench.executions.no_headers") %>
      </div>

      <% if execution.test_results.any? %>
        <div data-tabs-target="panel" data-name="tests" hidden>
          <%= render "workbench/requests/executions/tests", execution: %>
        </div>
      <% end %>

      <% if execution.script_logs.any? %>
        <div data-tabs-target="panel" data-name="console" hidden>
          <%= render "workbench/requests/executions/console", lines: execution.script_logs %>
        </div>
      <% end %>

      <% if cookies.any? %>
        <div data-tabs-target="panel" data-name="cookies" hidden>
          <%= render "workbench/requests/executions/cookies", cookies: %>
        </div>
      <% end %>

      <% if timing.present? %>
        <div data-tabs-target="panel" data-name="timing" hidden>
          <%= render "workbench/requests/executions/headers", headers: timing.to_h { |row| [t("workbench.executions.timing.phases.#{row[:phase]}"), format_timing(row[:milliseconds])] }.merge(t("workbench.executions.timing.total") => format_duration(execution.duration_ms)), bleed: true, total: true, empty: "" %>
        </div>
      <% end %>

      <div data-tabs-target="panel" data-name="request" hidden>
        <%= render "workbench/requests/executions/request", execution: %>
      </div>

      <div data-tabs-target="panel" data-name="payload" hidden class="h-full">
        <%= render "workbench/requests/executions/payload", execution: %>
      </div>

      <div data-tabs-target="panel" data-name="history" hidden class="p-2">
        <%= render "workbench/requests/executions/history", api_request:, history:, current_id: execution.id %>
      </div>
    </div>
  </div>
<% end %>
