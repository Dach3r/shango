<% if execution.error? %>
  <div role="alert" class="m-4 rounded-xl border border-danger/40 bg-danger/10 p-4">
    <p class="text-sm font-semibold text-danger"><%= t("workbench.executions.errors.#{execution.error_kind}", default: t("workbench.executions.errors.unknown")) %></p>
    <p class="mt-1 break-words font-mono text-xs text-body"><%= execution.error_message %></p>
  </div>
<% elsif execution.body_omitted %>
  <p class="p-4 text-sm text-muted"><%= t("workbench.executions.binary", size: format_size(execution.size_bytes), type: execution.content_type.presence || "—") %></p>
<% elsif execution.response_body.blank? %>
  <p class="p-4 text-sm text-muted"><%= t("workbench.executions.empty_body") %></p>
<% else %>
  <% pretty = pretty_body(execution) %>
  <% raw = execution.response_body %>
  <% html = body_language(execution.content_type) == "html" %>
  <div class="flex h-full min-h-0 flex-col" data-controller="response-body" data-response-body-pretty-value="<%= pretty %>" data-response-body-raw-value="<%= raw unless raw == pretty %>">
    <div class="flex items-center gap-1 px-3 py-2">
      <% modes = %w[pretty raw] + (html ? %w[preview] : []) %>
      <% modes.each do |mode| %>
        <button type="button" data-response-body-target="mode" data-action="response-body#show" data-response-body-mode-param="<%= mode %>" aria-pressed="<%= mode == "pretty" %>"
                class="cursor-pointer rounded-md px-2 py-1 text-xs font-medium text-muted transition hover:text-ink aria-pressed:bg-field aria-pressed:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50">
          <%= t("workbench.executions.modes.#{mode}") %>
        </button>
      <% end %>
      <button type="button" data-action="response-body#copy" data-copied-label="<%= t("workbench.executions.copied") %>"
              class="ml-auto flex cursor-pointer items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium text-muted transition hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/50">
        <%= lucide_icon "copy", class: "size-3.5" %><span data-label><%= t("workbench.executions.copy") %></span>
      </button>
    </div>
    <% if execution.body_truncated %>
      <p class="mx-3 mb-2 rounded-lg bg-amber-500/15 px-3 py-1.5 text-xs text-amber-700 dark:text-amber-400"><%= t("workbench.executions.truncated", limit: format_size(ApiClient::Requests::Run::BODY_LIMIT)) %></p>
    <% end %>
    <div class="min-h-0 flex-1 px-1">
      <%= render CodeEditor::Component.new(value: pretty, language: body_language(execution.content_type), readonly: true, class: "h-full", data: { response_body_target: "editor" }) %>
      <% if html %>
        <iframe data-response-body-target="frame" hidden sandbox="" srcdoc="<%= raw %>" title="<%= t("workbench.executions.modes.preview") %>" class="size-full rounded-lg bg-white"></iframe>
      <% end %>
    </div>
  </div>
<% end %>
