<section class="border-b border-line px-4 py-3">
  <div class="flex items-start gap-2.5">
    <span class="mt-px bg-field px-1.5 py-0.5 font-mono text-xs font-semibold text-ink"><%= execution.http_method %></span>
    <%= render "workbench/requests/executions/url", url: execution.url %>
  </div>
  <% if execution.redirects.any? %>
    <ol class="mt-3 ml-1 space-y-2 border-l border-line pl-4">
      <% execution.redirects.each do |hop| %>
        <li class="flex items-start gap-2.5">
          <span class="mt-px flex items-center gap-1 bg-amber-500/15 px-1.5 py-0.5 font-mono text-xs font-semibold text-amber-700 dark:text-amber-400">
            <%= lucide_icon "corner-down-right", class: "size-3" %><%= hop["status"] %>
          </span>
          <%= render "workbench/requests/executions/url", url: hop["to"] %>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>

<% if execution.unresolved_variables.any? %>
  <div class="m-4 border border-amber-500/40 bg-amber-500/10 p-3 text-xs text-amber-700 dark:text-amber-400">
    <%= t("workbench.executions.unresolved", names: execution.unresolved_variables.map { |name| "{{#{name}}}" }.to_sentence) %>
  </div>
<% end %>

<h3 class="flex items-center gap-2 border-b border-line px-4 py-2 text-xs font-semibold text-ink">
  <%= t("workbench.executions.request_headers") %>
  <span class="border border-line bg-field px-1.5 text-muted tabular-nums"><%= execution.request_headers.size %></span>
</h3>
<%= render "workbench/requests/executions/headers", headers: execution.request_headers, bleed: true, empty: t("workbench.executions.no_headers") %>
