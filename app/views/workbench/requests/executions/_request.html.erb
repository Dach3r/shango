<div>
  <p class="font-mono text-xs break-all"><span class="font-semibold text-ink"><%= execution.http_method %></span> <%= execution.url %></p>
  <% if execution.redirects.any? %>
    <ul class="mt-2 space-y-1 text-xs text-muted">
      <% execution.redirects.each do |hop| %>
        <li class="break-all"><%= hop["status"] %> → <span class="font-mono"><%= hop["to"] %></span></li>
      <% end %>
    </ul>
  <% end %>
</div>

<% if execution.unresolved_variables.any? %>
  <div class="rounded-xl border border-amber-500/40 bg-amber-500/10 p-3 text-xs text-amber-700 dark:text-amber-400">
    <%= t("workbench.executions.unresolved", names: execution.unresolved_variables.map { |name| "{{#{name}}}" }.to_sentence) %>
  </div>
<% end %>

<div>
  <h3 class="mb-2 text-xs font-semibold text-ink"><%= t("workbench.executions.request_headers") %></h3>
  <%= render "workbench/requests/executions/headers", headers: execution.request_headers, empty: t("workbench.executions.no_headers") %>
</div>
