<% bleed = local_assigns.fetch(:bleed, false) %>
<% total = local_assigns.fetch(:total, false) %>
<% if headers.blank? %>
  <p class="<%= class_names("text-sm text-muted", "p-4" => bleed) %>"><%= empty %></p>
<% else %>
  <table class="<%= class_names("w-full table-fixed border-collapse text-xs", "border border-line" => !bleed, "border-b border-line" => total) %>">
    <tbody class="divide-y divide-line">
      <% headers.each_with_index do |(name, value), index| %>
        <% emphasized = total && index == headers.size - 1 %>
        <tr class="<%= class_names("transition hover:bg-field/60", "bg-field" => emphasized) %>">
          <th scope="row" class="<%= class_names("w-2/5 border-r border-line px-3 py-2 text-left align-top font-mono break-all text-ink", "font-medium" => !emphasized, "font-bold" => emphasized, "pl-4" => bleed) %>"><%= name %></th>
          <td class="<%= class_names("px-3 py-2 align-top font-mono break-all", "text-body" => !emphasized, "font-bold text-ink" => emphasized) %>"><%= value %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
