<% row = "flex items-center justify-between gap-6 px-4 py-3" %>
<% title = "text-sm font-medium text-ink" %>
<% hint = "mt-0.5 text-xs text-muted" %>
<div class="divide-y divide-line border-b border-line" data-controller="dependent-setting" data-action="change->dependent-setting#update">
  <div class="<%= row %>">
    <div>
      <label for="api_request_settings_timeout" class="<%= title %>"><%= t("workbench.settings.timeout") %></label>
      <p class="<%= hint %>"><%= t("workbench.settings.timeout_hint", max: ApiRequest::MAX_TIMEOUT) %></p>
    </div>
    <%= number_field_tag "api_request[settings][timeout]", api_request.setting(:timeout), id: "api_request_settings_timeout", min: 1, max: ApiRequest::MAX_TIMEOUT, class: field_classes("w-24 shrink-0 text-right") %>
  </div>
  <div class="<%= row %>">
    <div>
      <p class="<%= title %>"><%= t("workbench.settings.follow_redirects") %></p>
      <p class="<%= hint %>"><%= t("workbench.settings.follow_redirects_hint") %></p>
    </div>
    <%= render Checkbox::Component.new(name: "api_request[settings][follow_redirects]", checked: api_request.setting(:follow_redirects), "aria-label": t("workbench.settings.follow_redirects"), data: { dependent_setting_target: "switch" }) %>
  </div>
  <div class="<%= row %> transition-opacity" data-dependent-row>
    <div>
      <label for="api_request_settings_max_redirects" class="<%= title %>"><%= t("workbench.settings.max_redirects") %></label>
      <p class="<%= hint %>"><%= t("workbench.settings.max_redirects_hint") %></p>
    </div>
    <%= number_field_tag "api_request[settings][max_redirects]", api_request.setting(:max_redirects), id: "api_request_settings_max_redirects", min: 0, max: ApiRequest::MAX_REDIRECTS, class: field_classes("w-24 shrink-0 text-right"), data: { dependent_setting_target: "input" } %>
    <%= hidden_field_tag "api_request[settings][max_redirects]", api_request.setting(:max_redirects), id: nil, disabled: true, data: { dependent_setting_target: "mirror" } %>
  </div>
  <div class="<%= row %>">
    <div>
      <p class="<%= title %>"><%= t("workbench.settings.verify_ssl") %></p>
      <p class="<%= hint %>"><%= t("workbench.settings.verify_ssl_hint") %></p>
    </div>
    <%= render Checkbox::Component.new(name: "api_request[settings][verify_ssl]", checked: api_request.setting(:verify_ssl), "aria-label": t("workbench.settings.verify_ssl")) %>
  </div>
  <div class="<%= row %>">
    <div>
      <p class="<%= title %>"><%= t("workbench.settings.use_cookie_jar") %></p>
      <p class="<%= hint %>"><%= t("workbench.settings.use_cookie_jar_hint") %></p>
    </div>
    <%= render Checkbox::Component.new(name: "api_request[settings][use_cookie_jar]", checked: api_request.setting(:use_cookie_jar), "aria-label": t("workbench.settings.use_cookie_jar")) %>
  </div>
</div>
