<%= render Modal::Component.new(icon: "terminal", title: t(".title"), size: :lg, form: "curl_import_form", submit: t(".submit"), submit_icon: "download") do %>
  <%= form_with url: workbench_collection_curl_import_path(@collection), method: :post, id: "curl_import_form", data: { turbo_frame: "_top" }, class: "space-y-4" do %>
    <% if @error.present? %>
      <div role="alert" class="border border-danger/40 bg-danger/10 px-4 py-3 text-sm text-danger"><%= @error %></div>
    <% end %>
    <%= hidden_field_tag :folder_id, params[:folder_id], id: nil %>

    <div>
      <label for="command" class="<%= label_classes %>"><%= t(".command") %></label>
      <%= text_area_tag :command, params[:command], id: "command", rows: 8, autofocus: true, spellcheck: false, placeholder: "curl -X POST https://api.example.com/users -H 'Content-Type: application/json' -d '{\"name\": \"Ada\"}'",
                        class: field_classes("font-mono text-xs") %>
      <p class="mt-1 text-xs text-muted"><%= t(".hint", collection: @collection.name) %></p>
    </div>
  <% end %>
<% end %>
