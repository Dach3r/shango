<% content_for :title, "#{t("workbench.title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% content_for :heading, t("workbench.title") %>

<%= render layout: "workbench/workspace" do %>
  <%= render EmptyState::Component.new(icon: "send", title: t("workbench.workspaces.show.heading"), description: workspace_tree.empty? ? t("workbench.workspaces.show.empty") : t("workbench.workspaces.show.pick")) do %>
    <%= button_to workbench_drafts_path, method: :post, class: button_classes(:primary), form_class: "contents" do %>
      <%= lucide_icon "send", class: "size-4" %><%= t("workbench.workspaces.show.new_request") %>
    <% end %>
    <%= link_to new_workbench_collection_path, data: { turbo_frame: "modal" }, class: button_classes(:secondary) do %>
      <%= lucide_icon "plus", class: "size-4" %><%= t("workbench.workspaces.show.new_collection") %>
    <% end %>
  <% end %>
<% end %>
