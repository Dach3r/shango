<%# Outcome of a port check. Render with `result:` (a Result from Network::PortChecks::Run). %>
<% if result.failure? %>
  <%= render "network/shared/error", result: result %>
<% else %>
  <% counts = result.data[:counts] %>
  <% rows = result.data[:rows] %>
  <% slowest = rows.filter_map { |row| row.ms unless row.status == :filtered }.max.to_f %>
  <% summary = t("network.ports.summary", open: counts[:open], closed: counts[:closed], filtered: counts[:filtered]) %>
  <%= render "network/shared/history_entry", label: result.data[:host], detail: summary, tone: counts[:open].positive? ? "ok" : "warn" %>

  <div class="border border-line bg-card">
    <div class="grid grid-cols-2 sm:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div class="col-span-2 flex flex-col gap-2 border-b border-line px-5 py-4 sm:col-span-1 sm:border-r sm:border-b-0">
        <p class="font-mono text-xs uppercase tracking-wide text-faint"><%= t("network.results.target") %></p>
        <p class="truncate font-mono text-sm text-ink"><%= result.data[:host] %></p>
        <p class="font-mono text-xs text-faint"><%= result.data[:address] %></p>
      </div>
      <% { open: "border-r", filtered: "sm:border-r", closed: "border-l sm:border-l-0" }.each do |status, border| %>
        <div class="flex flex-col gap-2 px-5 py-4 <%= border %> border-line">
          <%= render NetworkStatus::Component.new(status:) %>
          <p class="text-3xl leading-none font-medium text-ink"><%= counts[status] %></p>
        </div>
      <% end %>
    </div>
    <% if counts[:filtered] == rows.size %>
      <p class="border-t border-line px-5 py-3 text-sm text-muted"><%= t("network.ports.all_filtered") %></p>
    <% end %>

    <div class="overflow-x-auto border-t border-line">
      <table class="w-full text-left text-sm">
        <thead class="sr-only">
          <tr>
            <th scope="col"><%= t("network.ports.columns.port") %></th>
            <th scope="col"><%= t("network.ports.columns.service") %></th>
            <th scope="col"><%= t("network.ports.columns.status") %></th>
            <th scope="col"><%= t("network.ports.columns.latency") %></th>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <tr class="border-b border-line last:border-b-0">
              <td class="px-5 py-3 font-mono text-ink"><%= row.port %></td>
              <td class="px-3 py-3 text-muted"><%= row.service || "—" %></td>
              <td class="px-3 py-3"><%= render NetworkStatus::Component.new(status: row.status) %></td>
              <td class="w-1/3 min-w-24 px-3 py-3">
                <% if row.status != :filtered %>
                  <div class="h-1.5 bg-line" role="presentation"><div class="h-full bg-ink" style="width: <%= slowest.zero? ? 4 : [(row.ms * 100.0 / slowest).round, 4].max %>%"></div></div>
                <% end %>
              </td>
              <td class="px-5 py-3 text-right font-mono text-xs whitespace-nowrap text-muted"><%= row.status == :filtered ? "—" : "#{row.ms} ms" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
