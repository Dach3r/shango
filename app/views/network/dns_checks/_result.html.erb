<%# Outcome of a DNS check. Render with `result:` (a Result from Network::DnsChecks::Run). %>
<% if result.failure? %>
  <%= render "network/shared/error", result: result %>
<% else %>
  <% summary = result.data[:summary] %>
  <% rows = result.data[:rows] %>
  <% reached = result.data[:expected] ? summary[:matched] : summary[:answered] %>
  <% percent = summary[:total].zero? ? 0 : (reached * 100.0 / summary[:total]).round %>
  <% settled = reached == summary[:total] && (result.data[:expected] || summary[:agree]) %>
  <% tone = settled ? "ok" : (reached.zero? ? "bad" : "warn") %>
  <% detail = t(result.data[:expected] ? "network.dns.summary.expected" : "network.dns.summary.answered", matched: summary[:matched], answered: summary[:answered], total: summary[:total]) %>
  <%= render "network/shared/history_entry", label: "#{result.data[:host]} · #{result.data[:type]}", detail:, tone: %>

  <div class="border border-line bg-card">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-line px-5 py-4">
      <div class="w-28">
        <p class="font-mono text-xs uppercase tracking-wide text-faint"><%= t("network.results.propagation") %></p>
        <p class="mt-1 text-3xl font-medium text-ink"><%= percent %>%</p>
      </div>
      <div class="min-w-48 flex-1">
        <div class="h-1.5 bg-line" role="presentation"><div class="h-full <%= { "ok" => "bg-emerald-500", "warn" => "bg-amber-500", "bad" => "bg-danger" }.fetch(tone) %>" style="width: <%= percent %>%"></div></div>
        <p class="mt-2 text-sm font-semibold text-ink"><%= detail %></p>
        <% if summary[:answered].positive? %>
          <p class="mt-0.5 text-sm text-muted"><%= t(summary[:agree] ? "network.dns.summary.agree" : "network.dns.summary.differ") %></p>
        <% end %>
      </div>
      <p class="w-full font-mono text-xs text-faint"><%= result.data[:type] %> · <%= result.data[:host] %></p>
    </div>

    <% rows.group_by(&:group).each do |group, group_rows| %>
      <h3 class="border-b border-line px-5 pt-4 pb-2 font-mono text-xs uppercase tracking-wide text-faint"><%= t("network.dns.groups.#{group}") %></h3>
      <div class="overflow-hidden border-b border-line last:border-b-0">
        <div class="-mr-px -mb-px grid sm:grid-cols-2">
          <% group_rows.each do |row| %>
            <div class="flex min-w-0 flex-col gap-2 border-r border-b border-line px-5 py-3">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <span class="block truncate font-mono text-sm text-ink"><%= row.name %></span>
                  <span class="block font-mono text-xs text-faint"><%= row.ip || "—" %></span>
                </div>
                <div class="flex shrink-0 flex-col items-end gap-1">
                  <%= render NetworkStatus::Component.new(status: row.status) %>
                  <%= render NetworkStatus::Component.new(status: row.match) if row.match %>
                </div>
              </div>
              <div class="font-mono text-xs break-all text-body">
                <% if row.answers.any? %>
                  <% row.answers.each do |answer| %><span class="block"><%= "→ " if row.status == :cname %><%= answer %></span><% end %>
                <% else %>
                  <span class="text-faint">—</span>
                <% end %>
              </div>
              <p class="font-mono text-xs text-faint"><%= row.ttl ? "#{row.ttl}s" : "—" %> · <%= row.ms ? "#{row.ms} ms" : "—" %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if rows.none? { |row| row.group == :authoritative } %>
      <p class="border-t border-line px-5 py-3 text-sm text-muted"><%= t("network.dns.no_authoritative") %></p>
    <% end %>
  </div>
<% end %>
