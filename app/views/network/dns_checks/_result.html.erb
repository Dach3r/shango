<%# Outcome of a DNS check. Render with `result:` (a Result from Network::DnsChecks::Run). %>
<% if result.failure? %>
  <%= render "network/shared/error", result: result %>
<% else %>
  <% summary = result.data[:summary] %>
  <% rows = result.data[:rows] %>
  <div class="border border-line">
    <div class="border-b border-line bg-card px-4 py-3 text-sm text-ink">
      <p class="font-mono text-xs uppercase tracking-wide text-faint"><%= result.data[:type] %> · <%= result.data[:host] %></p>
      <% if result.data[:expected] %>
        <p class="mt-1 font-semibold"><%= t("network.dns.summary.expected", matched: summary[:matched], total: summary[:total]) %></p>
      <% else %>
        <p class="mt-1 font-semibold"><%= t("network.dns.summary.answered", answered: summary[:answered], total: summary[:total]) %></p>
      <% end %>
      <% if summary[:answered].positive? %>
        <p class="mt-0.5 text-muted"><%= t(summary[:agree] ? "network.dns.summary.agree" : "network.dns.summary.differ") %></p>
      <% end %>
    </div>

    <% rows.group_by(&:group).each do |group, group_rows| %>
      <h3 class="border-b border-line px-4 pt-3 pb-2 font-mono text-xs uppercase tracking-wide text-faint"><%= t("network.dns.groups.#{group}") %></h3>
      <div class="overflow-x-auto">
        <table class="w-full border-b border-line text-left text-sm last:border-b-0">
          <thead class="sr-only">
            <tr>
              <th scope="col"><%= t("network.dns.columns.resolver") %></th>
              <th scope="col"><%= t("network.dns.columns.answer") %></th>
              <th scope="col"><%= t("network.dns.columns.ttl") %></th>
              <th scope="col"><%= t("network.dns.columns.latency") %></th>
              <th scope="col"><%= t("network.dns.columns.status") %></th>
            </tr>
          </thead>
          <tbody>
            <% group_rows.each do |row| %>
              <tr class="border-b border-line align-top last:border-b-0">
                <td class="px-4 py-2.5">
                  <span class="block font-medium text-ink"><%= row.name %></span>
                  <span class="block font-mono text-xs text-muted"><%= row.ip || "—" %></span>
                </td>
                <td class="px-4 py-2.5 font-mono text-xs break-all text-body">
                  <% if row.answers.any? %>
                    <% row.answers.each do |answer| %><span class="block"><%= "→ " if row.status == :cname %><%= answer %></span><% end %>
                  <% else %>
                    <span class="text-faint">—</span>
                  <% end %>
                </td>
                <td class="px-4 py-2.5 font-mono text-xs whitespace-nowrap text-muted"><%= row.ttl ? "#{row.ttl}s" : "—" %></td>
                <td class="px-4 py-2.5 font-mono text-xs whitespace-nowrap text-muted"><%= row.ms ? "#{row.ms} ms" : "—" %></td>
                <td class="px-4 py-2.5">
                  <div class="flex flex-wrap gap-1">
                    <%= render NetworkStatus::Component.new(status: row.status) %>
                    <%= render NetworkStatus::Component.new(status: row.match) if row.match %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if rows.none? { |row| row.group == :authoritative } %>
      <p class="border-t border-line px-4 py-3 text-sm text-muted"><%= t("network.dns.no_authoritative") %></p>
    <% end %>
  </div>
<% end %>
