<%# Outcome of the subnet calculator. Render with `result:` (a Result from Network::Subnets::Calculate). %>
<% if result.failure? %>
  <%= render "network/shared/error", result: result %>
<% else %>
  <% data = result.data %>
  <% count = ->(number) { number < 2**53 ? number_with_delimiter(number) : "2^#{number.bit_length - 1}" } %>
  <div class="border border-line bg-card">
    <div class="flex flex-col gap-1 border-b border-line px-5 py-4">
      <p class="font-mono text-xs uppercase tracking-wide text-faint"><%= t("network.subnet.network") %></p>
      <p class="font-mono text-2xl font-medium break-all text-ink"><%= data[:cidr] %></p>
      <p class="font-mono text-xs text-faint"><%= t("network.subnet.family", version: data[:family]) %> · <%= t("network.subnet.scopes.#{data[:scope]}") %></p>
    </div>

    <div class="overflow-hidden">
      <dl class="-mr-px -mb-px grid sm:grid-cols-2">
        <% %i[address network netmask wildcard broadcast first last size hosts].each do |field| %>
          <% next if data[field].nil? %>
          <div class="flex min-w-0 flex-col gap-1 border-r border-b border-line px-5 py-3">
            <dt class="font-mono text-xs uppercase tracking-wide text-faint"><%= t("network.subnet.fields.#{field}") %></dt>
            <dd class="font-mono text-sm break-all text-ink"><%= data[field].is_a?(Integer) ? count.call(data[field]) : data[field] %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <% if data[:contains] %>
      <section class="border-t border-line">
        <h3 class="border-b border-line px-5 pt-4 pb-2 font-mono text-xs uppercase tracking-wide text-faint"><%= t("network.subnet.contains_title") %></h3>
        <div class="flex items-center justify-between gap-3 px-5 py-3">
          <span class="min-w-0 truncate font-mono text-sm text-ink"><%= data[:contains][:address] %></span>
          <%= render NetworkStatus::Component.new(status: data[:contains][:inside] ? :inside : :outside) %>
        </div>
      </section>
    <% end %>

    <% if data[:split] %>
      <% split = data[:split] %>
      <section class="border-t border-line">
        <h3 class="border-b border-line px-5 pt-4 pb-2 font-mono text-xs uppercase tracking-wide text-faint"><%= t("network.subnet.split_title", count: count.call(split[:count]), prefix: split[:prefix]) %></h3>
        <div class="overflow-hidden">
          <ul class="-mr-px -mb-px grid sm:grid-cols-2 xl:grid-cols-3">
            <% split[:subnets].each do |subnet| %>
              <li class="truncate border-r border-b border-line px-5 py-2 font-mono text-sm text-body"><%= subnet %></li>
            <% end %>
          </ul>
        </div>
        <% if split[:count] > split[:subnets].size %>
          <p class="border-t border-line px-5 py-3 text-sm text-muted"><%= t("network.subnet.split_truncated", shown: split[:subnets].size, count: count.call(split[:count])) %></p>
        <% end %>
      </section>
    <% end %>
  </div>
<% end %>
