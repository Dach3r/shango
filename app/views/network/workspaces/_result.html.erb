<%# The stored result of a saved run, or nothing. Render with `kind:`, `check:` and `result:`. %>
<% partials = { "dns" => "network/dns_checks/result", "ports" => "network/port_checks/result", "ping" => "network/pings/result" } %>
<% if check %>
  <%= render partials.fetch(kind), result:, check: %>
<% end %>
