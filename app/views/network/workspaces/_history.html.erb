<%# History of one tool, saved per user. Render with `tool:` (dns, ports or ping) and `current:` (the saved run on display, or nil). %>
<aside aria-label="<%= t("network.history.#{tool}") %>" class="flex w-full shrink-0 flex-col border-t border-line lg:min-h-0 lg:w-64 lg:border-t-0 lg:border-r">
  <div class="flex flex-col lg:min-h-0 lg:flex-1">
    <%= render "network/checks/list", kind: tool, checks: history_for(tool), current: %>
  </div>
</aside>
