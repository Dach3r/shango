<%# Panel of the TLS certificate check. Render with `check:` (the saved run on display, or nil) and `result:` (its stored result). %>
<div class="flex h-full min-h-0 flex-col-reverse lg:flex-row">
  <%= render "network/workspaces/history", tool: "tls", current: check %>

  <div class="relative flex min-h-0 min-w-0 flex-1 flex-col">
    <%= render "network/workspaces/tls_form", input: network_input(check) %>

    <div class="flex min-h-0 flex-1 flex-col lg:flex-row">
      <div id="tls_result" class="min-h-0 min-w-0 flex-1 overflow-y-auto p-6 empty:hidden lg:empty:block" aria-live="polite"><%= render "network/workspaces/result", kind: "tls", check:, result: %></div>

      <%= render "network/workspaces/aside", width: "lg:w-[calc(22rem-1px)]", hint: t("network.tls.hint"), statuses: %i[trusted untrusted valid expiring expired] %>
    </div>
  </div>
</div>
