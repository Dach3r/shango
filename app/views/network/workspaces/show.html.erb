<%# One tool of the Network workspace. Needs `@kind` and, for a saved run on display, `@check` and `@result`. %>
<% content_for :title, "#{t("network.title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% content_for :main_class, "flex min-h-0 flex-1" %>

<% tools = [
     { name: "dns", label: t("network.tabs.dns"), icon: "search" },
     { name: "ports", label: t("network.tabs.ports"), icon: "radar" },
     { name: "ping", label: t("network.tabs.ping"), icon: "activity" }
   ].map { |tool| tool.merge(path: network_workspace_path(tool[:name])) } %>

<div class="flex min-w-0 flex-1 flex-col lg:h-[calc(100vh-2.5rem)] lg:flex-row">
  <h1 class="sr-only"><%= t("network.title") %></h1>
  <%= render NetworkRail::Component.new(items: tools, current: @kind, label: t("network.tabs.label")) %>

  <div class="min-h-0 min-w-0 flex-1">
    <%= render "network/workspaces/#{@kind}", check: @check, result: @result %>
  </div>
</div>
