<%# Form bar of the DNS tool. Render with `input:` (what was typed before, string keys; empty for a fresh form). A non-empty `input` is a saved run: the bar is read-only. %>
<% readonly = input.present? %>
<%= tag.div id: "dns_form", class: "shrink-0", data: variable_autocomplete_data do %>
  <%= network_bar scope: :dns_check, url: network_dns_checks_path, readonly: readonly do |form| %>
    <%= form.label :domain, t("network.dns.domain"), class: "sr-only" %>
    <%= form.text_field :domain, readonly:, value: input.values_at("domain", "expected").compact_blank.join(" "), required: true, autocomplete: "off", spellcheck: false, placeholder: t("network.dns.domain_placeholder"), class: bar_field_classes("min-w-48 flex-1 font-mono") %>
    <%= render Select::Component.new(disabled: readonly, name: "dns_check[type]", options: Network::Dns::Query::TYPES.keys.map { |type| [type, type] }, value: input.fetch("type", "A"), id: "dns_check_type", label: t("network.dns.type"), class: "w-24 font-mono") %>
    <% if readonly %>
      <%= link_to network_workspace_path("dns"), class: button_classes(:primary) do %>
        <%= lucide_icon "plus", class: "size-4" %><%= t("network.new_check") %>
      <% end %>
    <% else %>
      <%= form.button type: :submit, class: button_classes(:primary) do %>
        <%= lucide_icon "search", class: "size-4" %><%= t("network.dns.submit") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
