<div class="flex h-full flex-col-reverse lg:flex-row" data-controller="network-history" data-network-history-key-value="ports">
  <%= render "network/workspaces/history", tool: "ports" %>

  <div class="flex min-w-0 flex-1 flex-col">
    <div class="border-b border-line px-6 py-4">
      <%= form_with scope: :port_check, url: network_port_checks_path, data: { network_history_target: "form" }, class: "flex flex-wrap items-end gap-2.5" do |form| %>
        <%= form.label :host, t("network.ports.host"), class: "sr-only" %>
        <%= form.text_field :host, required: true, autocomplete: "off", spellcheck: false, placeholder: t("network.ports.host_placeholder"), class: field_classes("min-w-48 flex-[2_1_12rem] font-mono") %>
        <%= form.label :ports, t("network.ports.ports"), class: "sr-only" %>
        <%= form.text_field :ports, value: "common", required: true, autocomplete: "off", spellcheck: false, placeholder: t("network.ports.ports_placeholder"), title: t("network.ports.ports"), class: field_classes("min-w-36 flex-[1_1_10rem] font-mono") %>
        <%= form.button type: :submit, class: button_classes(:primary) do %>
          <%= lucide_icon "radar", class: "size-4" %><%= t("network.ports.submit") %>
        <% end %>
      <% end %>
      <p class="mt-3 text-xs text-faint"><%= t("network.ports.intro") %> <%= t("network.ports.ports_hint", max: Network::PortChecks::PortSpec::MAX_PORTS) %></p>
    </div>
    <div id="ports_result" data-network-history-target="result" class="p-6 empty:hidden" aria-live="polite"></div>
  </div>
</div>
