<%# Panel of the ports tool. Render with `check:` (the saved run on display, or nil) and `result:` (its stored result). %>
<div class="flex h-full min-h-0 flex-col-reverse lg:flex-row">
  <%= render "network/workspaces/history", tool: "ports", current: check %>

  <div class="flex min-h-0 min-w-0 flex-1 flex-col">
    <%= render "network/workspaces/ports_form", input: check&.input || {} %>

    <div class="flex min-h-0 flex-1 flex-col lg:flex-row">
      <div id="ports_result" class="min-h-0 min-w-0 flex-1 overflow-y-auto p-6 empty:hidden lg:empty:block" aria-live="polite"><%= render "network/workspaces/result", kind: "ports", check:, result: %></div>

      <%= render "network/workspaces/aside", width: "lg:w-[22rem]", hint: t("network.ports.hint"), statuses: %i[open closed filtered] %>
    </div>
  </div>
</div>
