<%# Form bar of the TCP ping. Render with `input:` (what was typed before, string keys; empty for a fresh form). A non-empty `input` is a saved run: the bar is read-only. %>
<% readonly = input.present? %>
<%= tag.div id: "ping_form", class: "shrink-0", data: variable_autocomplete_data do %>
  <%= network_bar scope: :ping, url: network_pings_path, readonly: readonly do |form| %>
    <%= form.label :host, t("network.ping.host"), class: "sr-only" %>
    <%= form.text_field :host, readonly:, value: input["host"], required: true, autocomplete: "off", spellcheck: false, placeholder: t("network.ping.host_placeholder"), class: bar_field_classes("min-w-48 flex-[2_1_12rem] font-mono") %>
    <% port = input.fetch("port", Network::Pings::Run::DEFAULT_PORT).to_s %>
    <% port_options = Network::Services::NAMES.map { |number, name| ["#{number} · #{name}", number] } %>
    <% port_options.unshift([port, port]) unless Network::Services::NAMES.key?(port.to_i) && port == port.to_i.to_s %>
    <%= render Select::Component.new(disabled: readonly, name: "ping[port]", options: port_options, value: port, id: "ping_port", label: t("network.ping.port"), searchable: false, dock: true, dock_top: "top-14", dock_width: "lg:w-[calc(31rem-2px)] w-56", class: "w-44 font-mono aria-expanded:bg-ink/[0.08]! disabled:cursor-default disabled:opacity-100 disabled:[&_svg]:hidden") %>
    <%= render Select::Component.new(disabled: readonly, name: "ping[attempts]", options: (1..Network::Pings::Run::MAX_ATTEMPTS).map { |count| [t("network.ping.attempts_option", count:), count] }, value: input.fetch("attempts", Network::Pings::Run::DEFAULT_ATTEMPTS), id: "ping_attempts", label: t("network.ping.attempts"), searchable: false, dock: true, dock_top: "top-14", dock_width: "lg:w-[calc(31rem-2px)] w-56", class: "w-36 font-mono aria-expanded:bg-ink/[0.08]! disabled:cursor-default disabled:opacity-100 disabled:[&_svg]:hidden") %>
    <% if readonly %>
      <%= link_to network_workspace_path("ping"), class: button_classes(:primary, "w-44 shrink-0") do %>
        <%= lucide_icon "plus", class: "size-4" %><%= t("network.new_check") %>
      <% end %>
    <% else %>
      <%= form.button type: :submit, class: button_classes(:primary, "w-44 shrink-0") do %>
        <%= lucide_icon "activity", class: "size-4" %><%= t("network.ping.submit") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
