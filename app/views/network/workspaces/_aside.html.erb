<%# Info column of a tool. Render with `hint:` and `statuses:` (the NetworkStatus values the tool can show); `width:` is the lg width class (kept in step with the bar controls). %>
<aside class="flex w-full shrink-0 flex-col gap-6 overflow-y-auto border-t border-line p-6 lg:border-l lg:border-t-0 <%= width %>">
  <section class="min-w-0">
    <h3 class="flex items-center gap-2 font-mono text-xs uppercase tracking-wide text-faint"><%= lucide_icon "info", class: "size-3.5" %><%= t("network.limits.about") %></h3>
    <p class="mt-3 text-sm leading-relaxed text-muted"><%= hint %></p>
  </section>
  <section class="min-w-0">
    <h3 class="flex items-center gap-2 font-mono text-xs uppercase tracking-wide text-faint"><%= lucide_icon "list-checks", class: "size-3.5" %><%= t("network.guide.title") %></h3>
    <dl class="mt-3 border border-line bg-card">
      <% statuses.each do |status| %>
        <div class="flex flex-col gap-1 border-b border-line px-4 py-2.5 last:border-b-0">
          <dt><%= render NetworkStatus::Component.new(status:) %></dt>
          <dd class="text-xs leading-relaxed text-muted"><%= t("network.guide.#{status}") %></dd>
        </div>
      <% end %>
    </dl>
  </section>
</aside>
