<%# Form bar of the port check. Render with `input:` (what was typed before, string keys; empty for a fresh form). A non-empty `input` is a saved run: the bar is read-only. %>
<% readonly = input.present? %>
<%= tag.div id: "ports_form", class: "shrink-0", data: variable_autocomplete_data do %>
  <%= network_bar scope: :port_check, url: network_port_checks_path, readonly: readonly do |form| %>
    <%= form.label :host, t("network.ports.host"), class: "sr-only" %>
    <%= form.text_field :host, readonly:, value: input["host"], required: true, autocomplete: "off", spellcheck: false, placeholder: t("network.ports.host_placeholder"), class: bar_field_classes("min-w-48 flex-[2_1_12rem] font-mono") %>
    <%= form.label :ports, t("network.ports.ports"), class: "sr-only" %>
    <%= form.text_field :ports, readonly:, value: input.fetch("ports", "common"), required: true, autocomplete: "off", spellcheck: false, placeholder: t("network.ports.ports_placeholder"), title: t("network.ports.ports"), class: bar_field_classes("min-w-36 flex-[1_1_10rem] font-mono") %>
    <% if readonly %>
      <%= link_to network_workspace_path("ports"), class: button_classes(:primary) do %>
        <%= lucide_icon "plus", class: "size-4" %><%= t("network.new_check") %>
      <% end %>
    <% else %>
      <%= form.button type: :submit, class: button_classes(:primary) do %>
        <%= lucide_icon "radar", class: "size-4" %><%= t("network.ports.submit") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
