<%# Outcome of a TCP ping. Render with `result:` (a Result from Network::Pings::Run). %>
<% if result.failure? %>
  <%= render "network/shared/error", result: result %>
<% else %>
  <% summary = result.data[:summary] %>
  <div class="border border-line">
    <div class="border-b border-line bg-card px-4 py-3 text-sm text-ink">
      <p class="font-mono text-xs uppercase tracking-wide text-faint"><%= result.data[:host] %> · <%= result.data[:address] %>:<%= result.data[:port] %></p>
      <p class="mt-1 font-semibold"><%= t("network.ping.summary", received: summary[:received], sent: summary[:sent], loss: summary[:loss]) %></p>
      <% if summary[:received].positive? %>
        <p class="mt-0.5 font-mono text-xs text-muted"><%= t("network.ping.latency", min: summary[:min], avg: summary[:avg], max: summary[:max]) %></p>
        <% if summary[:open].zero? %>
          <p class="mt-0.5 text-muted"><%= t("network.ping.only_refused") %></p>
        <% end %>
      <% else %>
        <p class="mt-0.5 text-muted"><%= t("network.ping.no_answer") %></p>
      <% end %>
      <% if summary[:stopped] %>
        <p class="mt-0.5 text-muted"><%= t("network.ping.stopped", count: Network::Pings::Run::MAX_CONSECUTIVE_TIMEOUTS) %></p>
      <% end %>
    </div>

    <ol class="text-sm">
      <% result.data[:attempts].each_with_index do |attempt, index| %>
        <li class="flex items-center gap-4 border-b border-line px-4 py-2.5 last:border-b-0">
          <span class="w-6 font-mono text-xs text-faint"><%= index + 1 %></span>
          <span class="w-24"><%= render NetworkStatus::Component.new(status: attempt.status) %></span>
          <span class="font-mono text-xs text-muted"><%= "#{attempt.ms} ms" if attempt.status != :filtered %></span>
        </li>
      <% end %>
    </ol>
  </div>
<% end %>
