<%# Saved runs of one tool, newest first. Render with `kind:`, `checks:` and `current:` (the check on display, or nil). %>
<header class="flex h-14 shrink-0 items-center justify-between gap-2 border-b border-line px-5">
  <h2 class="truncate text-sm font-semibold text-ink"><%= t("network.history.#{kind}") %></h2>
  <% if checks.any? %>
    <%= button_to network_history_path(kind:), method: :delete, form_class: "contents", form: { data: { turbo_confirm: t("network.history.confirm_clear") } },
          class: "cursor-pointer px-1.5 py-0.5 font-mono text-xs uppercase tracking-wide text-faint transition hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %><%= t("network.history.clear") %><% end %>
  <% end %>
</header>
<% if checks.any? %>
  <ul class="max-h-72 overflow-y-auto lg:max-h-none lg:min-h-0 lg:flex-1">
    <% checks.each do |check| %>
      <% digest = check.digest %>
      <% active = check == current %>
      <li class="group relative flex items-stretch border-b border-line <%= "bg-card" if active %>">
        <%= link_to network_check_path(check), aria: { current: (active || nil) },
              class: "flex min-w-0 flex-1 flex-col gap-1 py-3 pr-9 pl-5 transition hover:bg-card focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50 focus-visible:ring-inset" do %>
          <span class="flex items-center gap-2">
            <span class="truncate font-mono text-sm text-ink"><%= digest.label %></span>
            <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full <%= { "ok" => "bg-emerald-500", "warn" => "bg-amber-500", "bad" => "bg-danger" }.fetch(digest.tone) %>"></span>
          </span>
          <span class="truncate text-xs text-faint"><%= t(digest.key, **digest.args) %> · <%= t("network.history.ago", time: time_ago_in_words(check.created_at)) %></span>
        <% end %>
        <%= button_to network_check_path(check), method: :delete, form_class: "contents", form: { data: { turbo_confirm: t("network.history.confirm_delete") } }, aria: { label: t("network.history.delete") },
              class: "absolute top-2 right-2 flex size-6 cursor-pointer items-center justify-center text-faint opacity-0 transition group-focus-within:opacity-100 group-hover:opacity-100 hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %><%= lucide_icon "x", class: "size-3.5" %><% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="px-5 py-4 text-sm text-muted"><%= t("network.history.empty") %></p>
<% end %>
