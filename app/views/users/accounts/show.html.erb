<% content_for :title, "#{t(".title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% content_for :heading, t(".title") %>

<%= render layout: "projects/environments/panel" do %>
  <section class="space-y-4">
    <div class="flex items-center gap-3 border border-line p-3">
      <span class="flex size-10 shrink-0 items-center justify-center bg-solid text-sm font-semibold text-on-solid" aria-hidden="true"><%= current_user.initials %></span>
      <div class="min-w-0">
        <p class="truncate text-sm font-medium text-ink"><%= current_user.full_name %></p>
        <p class="truncate text-xs text-muted"><%= current_user.email %></p>
      </div>
    </div>

    <%= render ToolsNav::Component.new %>

    <div class="border border-line">
      <%= link_to edit_user_registration_path, data: { turbo_frame: "_top" },
                  class: "flex h-12 w-full items-center gap-3 px-3 text-sm text-body transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
        <%= lucide_icon "settings", class: "size-4 shrink-0" %>
        <%= t("components.user_menu.settings") %>
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, form_class: "contents", form: { data: { turbo_frame: "_top" } },
                    class: "flex h-12 w-full cursor-pointer items-center gap-3 border-t border-line px-3 text-left text-sm text-body transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
        <%= lucide_icon "log-out", class: "size-4 shrink-0" %>
        <%= t("components.user_menu.sign_out") %>
      <% end %>
    </div>
  </section>
<% end %>
