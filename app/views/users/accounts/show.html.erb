<% content_for :title, "#{t(".title")} · #{ApplicationHelper::CONFIG[:name]}" %>
<% content_for :heading, t(".title") %>

<%= render layout: "projects/environments/panel" do %>
  <section class="-m-4 flex flex-1 flex-col divide-y divide-line">
    <%= render ToolsNav::Component.new %>

    <div class="mt-auto border-t border-line bg-field">
      <div class="flex items-center gap-3 px-4 py-3">
        <span class="flex size-9 shrink-0 items-center justify-center border border-line bg-card text-xs font-semibold tracking-wide text-ink" aria-hidden="true"><%= current_user.initials %></span>
        <div class="min-w-0 leading-tight">
          <p class="truncate text-sm font-medium text-ink"><%= current_user.full_name %></p>
          <p class="mt-0.5 truncate text-xs text-muted"><%= current_user.email %></p>
        </div>
      </div>
      <div class="grid grid-cols-2 divide-x divide-line border-t border-line">
        <%= link_to edit_user_registration_path, data: { turbo_frame: "_top" },
                    class: "flex h-10 items-center justify-center gap-2 text-sm font-medium text-body transition hover:bg-card hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
          <%= lucide_icon "settings", class: "size-4 shrink-0" %>
          <%= t("components.user_menu.settings") %>
        <% end %>
        <%= button_to destroy_user_session_path, method: :delete, form_class: "contents", form: { data: { turbo_frame: "_top" } },
                      class: "flex h-10 w-full cursor-pointer items-center justify-center gap-2 text-sm font-medium text-body transition hover:bg-card hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50" do %>
          <%= lucide_icon "log-out", class: "size-4 shrink-0" %>
          <%= t("components.user_menu.sign_out") %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
