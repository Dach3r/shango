<% turbo_refreshes_with method: content_for(:refresh_method).presence || :morph, scroll: :preserve %>
<% content_for :content do %>
  <div class="app-shell flex min-h-screen flex-col select-none" data-controller="right-sidebar">
    <div class="flex min-h-0 flex-1 flex-col">
      <div class="flex min-w-0 flex-col">
        <main class="<%= content_for?(:main_class) ? yield(:main_class) : "flex-1 px-4 py-8 sm:px-8" %>">
          <% if content_for?(:heading) && !content_for?(:main_class) %>
            <h1 class="mx-auto mb-6 max-w-3xl truncate text-lg font-semibold tracking-tight text-ink"><%= yield :heading %></h1>
          <% end %>
          <%= yield %>
        </main>
      </div>

      <div hidden data-right-sidebar-target="overlay" data-action="click->right-sidebar#close" class="fixed inset-x-0 top-0 bottom-10 z-30 bg-night-1000/60 backdrop-blur-sm"></div>

      <aside hidden data-right-sidebar-target="panel" aria-label="<%= t("layouts.app.right_sidebar") %>" class="fixed top-0 right-0 bottom-10 z-30 flex w-full max-w-md flex-col border-l border-line bg-page lg:w-[var(--right-sidebar-width,28rem)] lg:max-w-none">
        <header data-right-sidebar-target="header" class="flex h-10 shrink-0 [&[hidden]]:hidden items-center justify-between gap-2 border-b border-line px-4">
          <h2 class="truncate text-sm font-semibold text-ink" data-right-sidebar-target="title"></h2>
          <button type="button" data-action="right-sidebar#close" aria-label="<%= t("layouts.app.close_right_sidebar") %>"
                  class="flex size-8 shrink-0 cursor-pointer items-center justify-center text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50">
            <%= lucide_icon "x", class: "size-4" %>
          </button>
        </header>
        <div class="flex min-h-0 flex-1 flex-col overflow-y-auto p-4">
          <%= turbo_frame_tag "right_sidebar", class: "flex flex-1 flex-col" %>
        </div>
      </aside>
    </div>

    <%= render StatusBar::Component.new(user: current_user, project: current_project, projects: available_projects, environments: project_environments, current_environment:, open_incidents: open_incident_count) do %><%= yield :breadcrumb if content_for?(:breadcrumb) %><% end %>
  </div>
  <%= turbo_frame_tag "modal" %>
<% end %>

<%= render template: "layouts/application" %>
