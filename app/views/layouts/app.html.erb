<% content_for :content do %>
  <div class="flex min-h-screen flex-col" data-controller="right-sidebar">
    <div class="flex min-h-0 flex-1 flex-col lg:grid lg:grid-cols-[1fr_auto]">
      <div class="flex min-w-0 flex-col">
        <main class="<%= content_for?(:main_class) ? yield(:main_class) : "flex-1 px-4 py-8 sm:px-8" %>">
          <% if content_for?(:heading) && !content_for?(:main_class) %>
            <h1 class="mx-auto mb-6 max-w-3xl truncate text-lg font-semibold tracking-tight text-ink"><%= yield :heading %></h1>
          <% end %>
          <%= yield %>
        </main>
      </div>

      <aside hidden data-right-sidebar-target="panel" aria-label="<%= t("layouts.app.right_sidebar") %>" class="fixed inset-y-0 right-0 z-40 flex w-full max-w-md flex-col border-l border-line bg-page lg:sticky lg:top-0 lg:z-auto lg:h-[calc(100vh-2.5rem)] lg:w-[var(--right-sidebar-width,28rem)] lg:max-w-none">
        <header class="flex h-10 shrink-0 items-center justify-between gap-2 border-b border-line px-4">
          <h2 class="truncate text-sm font-semibold text-ink" data-right-sidebar-target="title"></h2>
          <button type="button" data-action="right-sidebar#close" aria-label="<%= t("layouts.app.close_right_sidebar") %>"
                  class="flex size-8 shrink-0 cursor-pointer items-center justify-center text-muted transition hover:bg-field hover:text-ink focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent/50">
            <%= lucide_icon "x", class: "size-4" %>
          </button>
        </header>
        <div class="flex min-h-0 flex-1 flex-col overflow-y-auto p-4">
          <%= turbo_frame_tag "right_sidebar", class: "flex flex-1 flex-col" %>
        </div>
      </aside>
    </div>

    <%= render StatusBar::Component.new(user: current_user, project: current_project, projects: current_user.projects.active.order(:name), environments: current_project.environments.ordered, current_environment:) do %><%= yield :breadcrumb if content_for?(:breadcrumb) %><% end %>
  </div>
  <%= turbo_frame_tag "modal" %>
<% end %>

<%= render template: "layouts/application" %>
